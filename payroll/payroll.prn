000774       if       Date-UK
000775                go to zz060-Exit.
000776       if       Date-USA                *> swap Month and Days
000777                move WS-Days to WS-Swap
000778                move WS-Month to WS-Days
000779                move WS-Swap to WS-Month
000780                go to zz060-Exit.
000781  *>
000782  *> So its International date format
000783  *>
000784       move     "ccyy/mm/dd" to WS-Date.  *> swap Intl to UK form
000785       move     U-Date (7:4) to WS-Intl-Year.
000786       move     U-Date (4:2) to WS-Intl-Month.
000787       move     U-Date (1:2) to WS-Intl-Days.
000788  *>
000789   zz060-Exit.
000790       exit     section.
