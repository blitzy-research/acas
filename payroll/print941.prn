000003C       *>
000004C        AN-Test-Status.
000005C            move     zeros to COB-CRT-STATUS.
000006C            evaluate AN-Return-Code
000007C                     when = zero
000008C                              move     zero to COB-CRT-STATUS
000009C                     when > zero and < 49 *> F1 thru F48
000010C                              compute COB-CRT-STATUS = AN-Return-Code + 1000
000011C                     when = 49            *> PAGE-UP - 2001
000012C                              move     2001 to COB-CRT-STATUS
000013C                     when = 50            *> PAGE-DOWN - 2002
000014C                              move     2002 to COB-CRT-STATUS
000015C                     when = 51            *> TAB    - 2007
000016C                              move     2007 to COB-CRT-STATUS
000017C                     when = 52            *> BACK-TAB - 2008
000018C                              move     2008 to COB-CRT-STATUS
000019C                     when = 99            *> ESCAPE - 2005
000020C                              move     2005 to COB-CRT-STATUS
000021C                     when other           *> No Others Coded For
000022C                              move     9000 to COB-CRT-STATUS
000023C            end-evaluate.
000024C       *>
