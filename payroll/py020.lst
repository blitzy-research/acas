    99  *>C  copy "selpyparam1.cob".
   100  *>
   101  *> Payroll param-1 (USA)
   102  *>
   103       select  PY-Param1-File  assign        File-47
   104                               access        dynamic
   105                               organization  is relative
   106                               relative key  is RRN
   107                               status        PY-PR1-Status.
   108  *>C  copy "selpyhrs.cob".
ACS Cobol Xref v2.03.18          Dictionary File for PY020    13/04/2026  23:09:03:82                                  Page    3

   109  *>
   110  *> Payroll Pay Hours (USA)
   111  *> Key in 2 parts, emp no and Trans-code
   112  *>
   113       select  PY-Pay-Transactions-File
   114                               assign        file-45
   115                               access        dynamic
   116                               organization  indexed
   117                               record key is Hrs-Key
   118                               status        PY-Hrs-Status.
   119  *>
   120  *>C  copy "selpyemp.cob".
   121  *>
   122  *> Payroll Employee (USA)
   123  *>
   124       select  PY-Employee-File
   125                               assign               File-43
   126                               access               dynamic
   127                               organization         indexed
   128                               record key is        Emp-No
   129                               alternate record key Emp-Search-Name with duplicates
   130                               status               PY-Emp-Status.
   131  *>
