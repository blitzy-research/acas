  2362   zz050-Validate-Date        section.
  2363  *>*********************************
  2364  *>
  2365  *>  Converts USA/Intl to UK date format for processing.
  2366  *>*******************************
  2367  *> Input:   WS-Test-Date
  2368  *> output:  U-Date/WS-Date as uk date format
  2369  *>          U-Bin not zero if valid date
  2370  *>
  2371       move     WS-Test-Date to WS-Date.
  2372       if       Date-Form = zero
  2373                move 1 to Date-Form.
  2374       if       Date-UK
  2375                go to zz050-Test-Date.
  2376       if       Date-USA                *> swap month and days
ACS Cobol Xref v2.03.18          Dictionary File for PY020    13/04/2026  23:09:03:85                                  Page   45

  2377                move WS-Days  to WS-Swap
  2378                move WS-Month to WS-Days
  2379                move WS-Swap  to WS-Month
  2380                go to zz050-Test-Date.
  2381  *>
  2382  *> So its International date format
  2383  *>
  2384       move     "dd/mm/ccyy" to WS-Date.  *> swap Intl to UK form
  2385       move     WS-Test-Date (1:4) to WS-Year.
  2386       move     WS-Test-Date (6:2) to WS-Month.
  2387       move     WS-Test-Date (9:2) to WS-Days.
  2388  *>
  2389   zz050-Test-Date.
  2390       move     WS-Date to U-Date.
  2391       move     zero to U-Bin.
  2392       perform  maps04.
  2393  *>
  2394   zz050-exit.
  2395       exit     section.
  2396  *>
  2397   zz060-Convert-Date        section.
  2398  *>********************************
  2399  *>
  2400  *>  Converts date in binary to UK/USA/Intl date format
  2401  *>****************************************************
  2402  *> Input:   U-Bin
  2403  *> output:  WS-Date as uk/US/Inlt date format
  2404  *>          U-Date & WS-Date = spaces if invalid date
  2405  *>
  2406       perform  maps04.
  2407       if       U-Date = spaces
  2408                move spaces to WS-Date
  2409                go to zz060-Exit.
  2410       move     U-Date to WS-Date.
  2411  *>
  2412       if       Date-Form = zero
  2413                move 1 to Date-Form.
  2414       if       Date-UK
  2415                go to zz060-Exit.
  2416       if       Date-USA                *> swap month and days
  2417                move WS-Days  to WS-Swap
  2418                move WS-Month to WS-Days
  2419                move WS-Swap  to WS-Month
  2420                go to zz060-Exit.
  2421  *>
  2422  *> So its International date format
  2423  *>
  2424       move     "ccyy/mm/dd" to WS-Date.  *> swap Intl to UK form
  2425       move     U-Date (7:4) to WS-Intl-Year.
  2426       move     U-Date (4:2) to WS-Intl-Month.
  2427       move     U-Date (1:2) to WS-Intl-Days.
  2428  *>
  2429   zz060-Exit.
  2430       exit     section.
ACS Cobol Xref v2.03.18          Dictionary File for PY020    13/04/2026  23:09:03:85                                  Page   46

  2431  *>
  2432   zz070-Convert-Date          section.
  2433  *>**********************************
  2434  *>
  2435  *>  Converts date in To-Day to UK/USA/Intl date format using ACAS param
  2436  *>*********************************************************************
  2437  *> Input:   To-Day
  2438  *> output:  WS-Date as uk/US/Inlt date format
  2439  *>
  2440       move     To-Day to WS-Date.
  2441  *>
  2442       if       Date-Form = zero
  2443                move 1 to Date-Form.
  2444       if       Date-UK
  2445                go to zz070-Exit.
  2446       if       Date-USA                *> Swap month and days
  2447                move WS-Days  to WS-Swap
  2448                move WS-Month to WS-Days
  2449                move WS-Swap  to WS-Month
  2450                go to zz070-Exit.
  2451  *>
  2452  *> So its International date format
  2453  *>
  2454       move     "ccyy/mm/dd" to WS-Date.  *> Swap Intl to UK form
  2455       move     To-Day (7:4) to WS-Intl-Year.
  2456       move     To-Day (4:2) to WS-Intl-Month.
  2457       move     To-Day (1:2) to WS-Intl-Days.
  2458  *>
  2459   zz070-Exit.
  2460       exit     section.
  2461  *>
  2462   zz100-Preset-Window section.
  2463  *>**************************
  2464  *>
  2465       if       WS-Wide-Screen-Used = "N"
  2466                perform  zz110-Set-Window
  2467       else
  2468                perform  zz130-Show-Trans-Types.
  2469  *>
  2470   zz100-Exit.  exit section.
  2471  *>
  2472   zz110-Set-Window   section.
  2473  *>*************************
  2474  *>
  2475  *> Save screen, show the defaults then restore the prev. screen.
  2476  *>
  2477       if       Cob-CRT-Status = Cob-Scr-F1
  2478                move     z"py-temp.scr"  to wScreenName
  2479   *>             call     "scr_dump"    using wScreenName
  2480                call     "CBL_GC_SCR_DUMP" using wScreenName
  2481                                           returning wInt
  2482                perform  zz120-Show-Trans-Types
  2483  *>              call     "scr_restore" using wScreenName
  2484                call      "CBL_GC_SCR_RESTORE" using wScreenName
ACS Cobol Xref v2.03.18          Dictionary File for PY020    13/04/2026  23:09:03:85                                  Page   47

  2485                                               returning wInt
  2486                call     "CBL_DELETE_FILE" using wScreenName  *>     Path-Work
  2487       end-if.
  2488   zz110-Exit.   exit section.
  2489  *>
  2490   zz120-Show-Trans-Types     section.
  2491  *>*********************************
  2492  *>
  2493  *> This routine WILL search through all of the table
  2494  *>  despite the later half of it only having N in field
  2495  *>  WS-OK-2-Ent set as N - IT is just in case the tables
  2496  *>  is expanded over time in the life of Payroll system.
  2497  *>
  2498       display  SS-Show-Trans-Codes-Heads.
  2499  *>
  2500       move     5 to A.    *> Line #
  2501       move     zero to B. *> table pos
  2502       perform  forever
  2503                if       A = WS-Tables-Sizes       *> Size of the two tables chg value if table changed
  2504                         display  SY004    at line WS-23-Lines col  1 erase eol
  2505                         accept   WS-Reply at line WS-23-Lines col 32 AUTO
  2506                         exit perform
  2507                end-if
  2508                add      1 to A
  2509  *>
  2510  *> We needs 22 lines to display all Trans codes so really terminal depth should
  2511  *> be 22 + 6 + 3 => 31 to display all on one screen full.
  2512  *>
  2513                if       A > WS-22-Lines
  2514                         display  SY014    at line WS-23-Lines col  1 erase eol
  2515                         accept   WS-Reply at line WS-23-Lines col 32 AUTO
  2516                         display  SS-Show-Trans-Codes-Heads
  2517                         move     6 to A
  2518                end-if
  2519                add      1 to B
  2520                if       WS-OK-2-Ent (B) = "N"
  2521                   and   B not = 1
  2522                         exit perform cycle
  2523                end-if
  2524  *>
  2525                display  WS-ED-No (B)    at line A  col 13
  2526                display  WS-ED-Desc (B)  at line A  col 18
  2527                display  WS-OK-Cat (B)   at line A  col 26
  2528                exit perform cycle
  2529       end-perform.
  2530  *>
  2531   zz120-Exit.  exit section.
  2532  *>
  2533   zz130-Show-Trans-Types     section.
  2534  *>*********************************
  2535  *>
  2536  *> This routine WILL search through all of the table
  2537  *>  despite the later half of it only having N in field
  2538  *>  WS-OK-2-Ent set as N - IT is just in case the tables
ACS Cobol Xref v2.03.18          Dictionary File for PY020    13/04/2026  23:09:03:85                                  Page   48

  2539  *>  is expanded over time in the life of Payroll system.
  2540  *>
  2541  *> THIS routine as against zz120 will show data from cc 81 leaving
  2542  *> existing display present.
  2543  *>
  2544       display  SS-Show-Trans-Codes-Heads-Wide.
  2545  *>
  2546       move     5 to A.    *> Line #
  2547       move     zero to B. *> table pos
  2548       perform  forever
  2549                if       A = WS-Tables-Sizes       *> Size of the two tables chg value if table changed
  2550                         display  SY004    at line WS-23-Lines col  81 erase eol
  2551                         accept   WS-Reply at line WS-23-Lines col 112 AUTO
  2552                         exit perform
  2553                end-if
  2554                add      1 to A
  2555  *>
  2556  *> We needs 22 lines to display all Trans codes so really terminal depth should
  2557  *> be 22 + 6 + 3 => 31 to display all on one screen full.
  2558  *>
  2559                if       A > WS-22-Lines
  2560                         display  SY014    at line WS-23-Lines col  81 erase eol
  2561                         accept   WS-Reply at line WS-23-Lines col 112 AUTO
  2562                         move     zero to C
  2563                         perform  forever   *> Manually clear down displ from cc 81
  2564                                  add      1 to C
  2565                                  if       C > WS-22-Lines
  2566                                           exit perform
  2567                                  end-if
  2568                                  display  space at line C col 81 erase eol
  2569                                  exit perform cycle
  2570                         end-perform
  2571                         display  SS-Show-Trans-Codes-Heads-Wide
  2572                         move     6 to A
  2573                end-if
  2574                add      1 to B
  2575                if       WS-OK-2-Ent (B) = "N"
  2576                   and   B not = 1
  2577                         exit perform cycle
  2578                end-if
  2579  *>
  2580                display  WS-ED-No (B)    at line A  col 93
  2581                display  WS-ED-Desc (B)  at line A  col 98
  2582                display  WS-OK-Cat (B)   at line A  col 106
  2583                exit perform cycle
  2584       end-perform.
  2585  *>
  2586   zz130-Exit.  exit section.
