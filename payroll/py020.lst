  2615  *>C      copy "an-accept.pl".
  2616        *>
  2617        *> performed after calling "accept_numeric" routine
  2618        *>
  2619         AN-Test-Status.
  2620             move     zeros to COB-CRT-STATUS.
  2621             evaluate AN-Return-Code
  2622                      when = zero
  2623                               move     zero to COB-CRT-STATUS
  2624                      when > zero and < 49 *> F1 thru F48
  2625                               compute COB-CRT-STATUS = AN-Return-Code + 1000
  2626                      when = 49            *> PAGE-UP - 2001
  2627                               move     2001 to COB-CRT-STATUS
  2628                      when = 50            *> PAGE-DOWN - 2002
  2629                               move     2002 to COB-CRT-STATUS
  2630                      when = 51            *> TAB    - 2007
  2631                               move     2007 to COB-CRT-STATUS
  2632                      when = 52            *> BACK-TAB - 2008
  2633                               move     2008 to COB-CRT-STATUS
  2634                      when = 99            *> ESCAPE - 2005
  2635                               move     2005 to COB-CRT-STATUS
  2636                      when other           *> No Others Coded For
  2637                               move     9000 to COB-CRT-STATUS
  2638             end-evaluate.
