000060C *>
000061C      END-EVALUATE.
000062C
002190  *>
002191   zz040-Eval-Msg-Exit.
002192       exit     section.
002193  *>
002194   zz070-Convert-Date          section.  *>  NOT USED YET
002195  *>**********************************
002196  *>
002197  *>  Converts date in To-Day to UK/USA/Intl date format using ACAS param
002198  *>*********************************************************************
002199  *> Input:   To-Day
002200  *> output:  WS-Date as uk/US/Inlt date format
002201  *>
002202       move     To-Day to WS-Date.
002203  *>
002204       if       Date-Form = zero
002205                move 1 to Date-Form.
002206       if       Date-UK
002207                go to zz070-Exit.
002208       if       Date-USA                *> Swap month and days
002209                move WS-Days  to WS-Swap
002210                move WS-Month to WS-Days
002211                move WS-Swap  to WS-Month
002212                go to zz070-Exit.
002213  *>
002214  *> So its International date format
002215  *>
002216       move     "ccyy/mm/dd" to WS-Date.  *> Swap Intl to UK form
002217       move     To-Day (7:4) to WS-Intl-Year.
002218       move     To-Day (4:2) to WS-Intl-Month.
002219       move     To-Day (1:2) to WS-Intl-Days.
002220  *>
002221   zz070-Exit.
002222       exit     section.
002223  *>
002224   zz100-Coh-Read-Error.
002225       display  PY013 at line WS-23-Lines col 1 erase eos
002226                              foreground-color 4 BEEP.
002227       display  PY-COH-Status at line WS-23-Lines col 44.
002228       move     PY-COH-Status to PY-PR1-Status.
002229       perform  ZZ040-Evaluate-Message.
002230       display  WS-Eval-Msg   at line WS-23-lines col 47.
002231       display  SY001 at line WS-lines col 01 with foreground-color cob-color-red
002232                                                   erase eol BEEP.
002233       accept   WS-Reply at line WS-lines col 52 AUTO.


