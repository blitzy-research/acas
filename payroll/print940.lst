ACS Cobol Xref v2.03.18          Dictionary File for PRINT940    24/03/2026  16:12:39:41                               Page   32

  1675                add      His-YTD-Income-Taxable
  1676                         His-YTD-Other-Taxable
  1677                         His-YTD-Other-NonTaxable
  1678                         His-YTD-Tips  giving WS-Pay
  1679                add      WS-Pay   to  WS-Tot-Renum-Paid
  1680                if       WS-Pay > Ded-Co-Futa-Limit
  1681                         compute   WS-Over-6k = WS-Pay - Ded-Co-Futa-Limit
  1682                end-if
  1683  *> Calulations
  1684                add      WS-Over-6k
  1685                         Coh-YTD-Other-NonTaxable giving WS-Exempt
  1686                move     Ded-Co-SUI-Rate         to WS-Rate9
  1687                move     Ded-Co-Futa-Max-Credit  to WS-Max-Rate9
  1688                add      Coh-YTD-Income-Taxable
  1689                         Coh-YTD-Other-Taxable
  1690                         Coh-YTD-Tips
  1691                                                  giving WS-Gross-Pay
  1692                multiply WS-Gross-Pay by Ded-Co-Futa-Max-Credit
  1693                                                  giving WS-Contrib-at-2-7
  1694                multiply WS-Gross-Pay by Ded-Co-SUI-Rate
  1695                                                  giving WS-Contrib-at-Rate
  1696                compute  WS-AddL-Credits = WS-Contrib-at-2-7 - WS-Contrib-at-Rate
  1697                if       WS-AddL-Credits negative
  1698                         move     zero to WS-AddL-Credits
  1699                end-if
  1700                move     WS-Contrib-at-Rate to WS-Actual-Contrib   *> should equal coh.ytd.co.sui.liab
  1701                compute  WS-Tot-Tent-Cred =  WS-AddL-Credits + WS-Actual-Contrib
  1702                compute  WS-Tot-Taxable-Futa = WS-Tot-Renum-Paid - WS-Exempt
  1703                compute  WS-Gross-Fed-Tax = WS-Tot-Taxable-Futa * Ded-Co-Futa-Rate
  1704                compute  WS-Maximum-Cred  = WS-Tot-Taxable-Futa * Ded-Co-Futa-Max-Credit
  1705                if       WS-Tot-Tent-Cred < WS-Maximum-Cred
  1706                         move     WS-Tot-Tent-Cred to  WS-Smaller
  1707                else
  1708                         move     WS-Maximum-Cred  to  WS-Smaller
  1709                end-if
  1710  *> Not sure about this as should be processed via RI State tax.
  1711                if       PY-PR1-Co-State = "RI"                     *> Rhode Island,  what is this?,  still valid ?
  1712                         move     WS-Tot-Taxable-Futa to WS-RI-Tax
  1713                         multiply WS-RI-Tax by 0.375 giving WS-RI-Cred   *> RI Tax at 3.75%  IS this valid ?
  1714                else
  1715                         move     zero to WS-RI-Tax
  1716                                          WS-RI-Cred
  1717                end-if
  1718                compute  WS-Cred-Allowable = WS-Smaller - WS-RI-Cred
  1719                compute  WS-Net-Fed-Tax    = WS-Gross-Fed-Tax - WS-Cred-Allowable
  1720                move     zero to WS-Tot-Deposited
  1721                         A
  1722                perform  4 times
  1723                         add      1 to A
  1724                         add      Coh-Q-Co-Futa-Liab (A) to WS-Tot-Deposited
  1725                end-perform
  1726                compute  WS-Balance-Due = WS-Net-Fed-Tax - WS-Tot-Deposited
  1727                if       WS-Balance-Due negative
  1728                         multiply WS-Balance-Due by -1 giving WS-Overpay
ACS Cobol Xref v2.03.18          Dictionary File for PRINT940    24/03/2026  16:12:39:41                               Page   33

  1729                         move     zero to WS-Balance-Due
  1730                end-if
