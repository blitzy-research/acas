ACS Cobol Xref v2.03.18          Dictionary File for PRINT940    24/03/2026  16:12:39:41                               Page   29

  1513                            WS-System-Record *> ACAS
  1514                            To-Day           *> ACAS
  1515                            File-Defs.       *> ACAS
  1516  *>
  1517   aa000-Main                  section.
  1518  *>**********************************
  1519  *> Force Esc, PgUp, PgDown, PrtSC to be detected
  1520       set      ENVIRONMENT "COB_SCREEN_EXCEPTIONS" to "Y".
  1521       set      ENVIRONMENT "COB_SCREEN_ESC" to "Y".
  1522       move     Current-Date to WSE-Date-block.
  1523       move     WSE-Date-9  to WS-Test-YMD.
  1524       move     Print-Spool-Name to PSN.  *> set ACAS prt spool for o/p
  1525  *>
  1526  *> Create common-date in ccyymmdd form.
  1527  *>   assuming To-Day is in Locale format ie USA mm.dd/ccyy
  1528  *>
  1529       move     To-Day (7:4)      to WS-Common-Date (1:4).
  1530       if       PY-PR1-Date-Format = 2
  1531                move To-Day (1:2) to WS-Common-Date (5:2)  *> mm
  1532                move To-Day (4:2) to WS-Common-Date (7:2)  *> dd
  1533       else
  1534                move To-Day (4:2) to WS-Common-Date (5:2)  *> mm
  1535                move To-Day (1:2) to WS-Common-Date (7:2). *> dd
  1536  *>
  1537       perform  forever
  1538                accept   WS-Env-Lines   from lines
  1539                if       WS-Env-Lines < 28
  1540                         display  SY010    at 0101 with erase eos
  1541                         accept   WS-Reply at 0133
  1542                         move     8 to WS-Term-Code
  1543                         exit perform cycle
  1544                end-if
  1545                accept   WS-Env-Columns from Columns
  1546                if       WS-Env-Columns < 80
  1547                         display  SY013    at 0101 with erase eos
  1548                         accept   WS-Reply at 0130
  1549                         move     8 to WS-Term-Code
  1550                         exit perform cycle
  1551                end-if
