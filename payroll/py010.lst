   182  *>C  copy "selpyemp.cob".
   183  *>
   184  *> Payroll Employee (USA)
   185  *>
   186       select  PY-Employee-File
   187                               assign               File-43
   188                               access               dynamic
   189                               organization         indexed
   190                               record key is        Emp-No
   191                               alternate record key Emp-Search-Name with duplicates
   192                               status               PY-Emp-Status.
   193  *>
