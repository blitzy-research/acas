  2492  *>
  2493   ca000-8100                   section.
  2494  *>***********************************
  2495  *>
  2496  *> This routine will accumulate the pay-amt & Units that has just been read in.
  2497  *>
  2498  *> Accumulation is based on the value of the PAY.REPORTING.CAT% variable.
  2499  *> Note that there is no rate zero, but all other VALID rates are accumulated.
  2500  *>
  2501       evaluate Pay-Reporting-Cat
  2502       when = 1  add     Pay-Units to WS-Units (1)
  2503                 add     Pay-Amt   to WS-Reg-Wages
  2504  *>
  2505       when = 2 or = 3 or = 4
  2506                 add     Pay-Amt   to WS-Other-Earn
  2507
  2508       when = 5  add     Pay-Units to WS-Vac-Taken
  2509       when = 6  add     Pay-Units to WS-SL-Taken
  2510       when = 7  add     Pay-Units to WS-Comp-Taken
  2511       when = 8  add     Pay-Units to WS-Comp-Earned
  2512       when = 9 or = 11 or = 12 or = 13 or = 14 or = 15 or = 17
  2513                 add     Pay-Amt   to WS-Other-Earn
  2514       when = 10 add     Pay-Amt   to WS-Tips
  2515       when = 16 add     Pay-Amt   to WS-EIC
  2516       when = 18 add     Pay-Amt   to WS-Tips
  2517                                      WS-Tips-Reported
  2518                                      WS-Other-Ded
  2519
  2520       when = 20 or = 28
  2521                 add     Pay-Amt   to WS-FWT
  2522       when = 21 or = 29
  2523                 add     Pay-Amt   to WS-SWT
  2524       when = 22 or = 30
  2525                 add     Pay-Amt   to WS-LWT
  2526       when = 23 or = 31
  2527                 add     Pay-Amt   to WS-FICA
  2528       when = 24 add     Pay-Amt   to WS-SDI
  2529       when = 27 add     Pay-Amt   to WS-Other-Ded
  2530       when = 33 or 34 or 35 or 36 or 37
  2531                 add     Pay-Amt   to WS-Sys (Pay-Reporting-Cat - 32)
  2532                 if      Ded-Sys-Earn-Ded (Pay-Reporting-Cat - 32) = "E"
  2533                         add  Pay-Amt  to WS-Other-Earn
  2534                 else
  2535                         add  Pay-Amt  to WS-Other-Ded
  2536                 end-if
  2537       when = 38 or 39 or 40
  2538                 add     Pay-Amt   to WS-Emp (Pay-Reporting-Cat - 37)
ACS Cobol Xref v2.03.18          Dictionary File for PYJOURN    19/04/2026  23:25:56:43                                Page   48

  2539                 if      Emp-Ed-Earn-Ded (Pay-Reporting-Cat - 37) = "E"
  2540                         add  Pay-Amt  to WS-Other-Earn
  2541                 else
  2542                         add  Pay-Amt  to WS-Other-Ded
  2543                 end-if
  2544       when = 42 add  Pay-Amt  to WS-CO-Fica
  2545                                  WS-Employer-Cost
  2546       when = 43 add  Pay-Amt  to WS-CO-Futa
  2547                                  WS-Employer-Cost
  2548       when = 44 add  Pay-Amt  to WS-CO-SUI
  2549                                  WS-Employer-Cost
  2550       end-evaluate.
  2551  *>
  2552   ca000-12700                  section.
  2553  *>***********************************
  2554  *>
  2555  *> Accumulate company totals
  2556  *>
  2557       add      WS-Reg-Wages      to WS-Total-Reg-Wages.
  2558       add      WS-Other-Earn     to WS-Total-Other-Earn.
  2559       add      WS-Tips           to WS-Total-Tips.
  2560       add      WS-Tips-Reported  to WS-Total-Tips-Reported.
  2561       add      WS-FWT            to WS-Total-FWT.
  2562       add      WS-SWT            to WS-Total-SWT.
  2563       add      WS-LWT            to WS-Total-SWT.
  2564       add      WS-FICA           to WS-Total-FICA.
  2565       add      WS-SDI            to WS-Total-SDI.
  2566       add      WS-Other-Ded      to WS-Total-Other-Ded.
  2567       add      WS-Net            to WS-Total-Net.
  2568       add      WS-Eic            to WS-Total-Eic.
  2569       add      WS-Co-Fica        to WS-Total-Co-Fica.
  2570       add      WS-Co-Futa        to WS-Total-Co-Futa.
  2571       add      WS-Co-Sui         to WS-Total-Co-Sui.
  2572       add      WS-Vac-Taken      to WS-Total-Vac-Taken.
  2573       add      WS-SL-Taken       to WS-Total-SL-Taken.
  2574       add      WS-Comp-Taken     to WS-Total-Comp-Taken.
  2575       add      WS-Comp-Earned    to WS-Total-Comp-Earned.
  2576       perform  varying A from 1 by 1 until A > 4
  2577                add      WS-Units (A) to WS-Total-Units (A)
  2578       end-perform.
  2579  *>
