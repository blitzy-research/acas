                       move     6 to A
              end-if
              add      1 to B
              if       WS-OK-2-Ent (B) = "N"
                 and   B not = 1
                       exit perform cycle
              end-if
*>
              display  WS-ED-No (B)    at line A  col 93
              display  WS-ED-Desc (B)  at line A  col 98
              display  WS-OK-Cat (B)   at line A  col 106
              exit perform cycle
