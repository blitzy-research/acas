  5239  *>C      copy "an-accept.pl".
  5240        *>
  5241        *> performed after calling "accept_numeric" routine
  5242        *>
  5243         AN-Test-Status.
  5244             move     zeros to COB-CRT-STATUS.
  5245             evaluate AN-Return-Code
  5246                      when = zero
  5247                               move     zero to COB-CRT-STATUS
  5248                      when > zero and < 49 *> F1 thru F48
  5249                               compute COB-CRT-STATUS = AN-Return-Code + 1000
  5250                      when = 49            *> PAGE-UP - 2001
  5251                               move     2001 to COB-CRT-STATUS
  5252                      when = 50            *> PAGE-DOWN - 2002
  5253                               move     2002 to COB-CRT-STATUS
  5254                      when = 51            *> TAB    - 2007
  5255                               move     2007 to COB-CRT-STATUS
  5256                      when = 52            *> BACK-TAB - 2008
  5257                               move     2008 to COB-CRT-STATUS
  5258                      when = 99            *> ESCAPE - 2005
  5259                               move     2005 to COB-CRT-STATUS
  5260                      when other           *> No Others Coded For
  5261                               move     9000 to COB-CRT-STATUS
  5262             end-evaluate.
  5263        *>
