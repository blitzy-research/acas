  5027                goback   returning 16.
  5028  *>
  5029   ab070-Exit.   exit section.
  5030  *>
  5031  *>
  5032   zz010-Test-YMD              section.
  5033  *>**********************************
  5034  *>
  5035       move     WS-Year  to WS-Test-YMD (1:4).
  5036       if       PY-PR1-Date-Format = 2   *> test for USA - mmddyyyy - -> yyyymmdd
  5037                move     WS-Days  to WS-Test-YMD (5:2)
  5038                move     WS-Month to WS-Test-YMD (7:2)
  5039       else
  5040                move     WS-Days  to WS-Test-YMD (7:2)  *> test for UK - ddmmyyyy -> yyyymmdd
  5041                move     WS-Month to WS-Test-YMD (5:2).
  5042  *>
  5043       move     zero  to A.
  5044       move     TEST-DATE-YYYYMMDD(WS-Test-YMD) to A.
  5045
  5046   zz010-Exit.  exit section.
  5047  *>
  5048  *> zz020-Display-Heads         section.
  5049  *>**********************************
  5050  *>
  5051  *>     display  " " at 0101 with erase eos.
  5052  *>     display  Prog-Name              at 0101 with foreground-color 2.
  5053  *>     display  WS-Heading             at 0131 with foreground-color 2.
  5054  *>     move     To-Day to WS-Date.
  5055  *>     perform  zz070-Convert-Date.
  5056  *>     display  WS-Date                at 0171 with foreground-color 2.
  5057  *>
  5058  *> zz020-Exit.  exit section.
  5059  *>
  5060   ZZ040-Evaluate-Message      Section.
  5061  *>**********************************
  5062  *>
  5063  *> For PY-PR1 parameter file anfd other using PR-PR1-Status.
  5064  *>
  5065  *>C      copy "FileStat-Msgs-2.cpy" replacing MSG    by WS-Eval-Msg
  5066  *>C                                         STATUS by PY-PR1-Status.
  5067  *> ***************************************************************
  5068  *> ** Author: Gary L. Cutler                                    **
  5069  *> **         CutlerGL@gmail.com                                **
  5070  *> ** Amendments Vincent B. Coen                                **
  5071  *> **         vbcoen@gmail.com                                  **
  5072  *> **                                                           **
  5073  *> ** This copybook defines an EVALUATE statement capable of    **
  5074  *> ** translating two-digit FILE-STATUS codes to a message.     **
  5075  *> **                                                           **
  5076  *> ** Use the REPLACING option to COPY to change the names of   **
ACS Cobol Xref v2.03.18          Dictionary File for PY900    24/03/2026  18:58:24:61                                  Page   95

  5077  *> ** the MSG and STATUS identifiers to                         **
  5078  *> ** the names your program needs.                             **
  5079  *> Such as replacing STATUS by fs-reply msg by exception-msg.   **
  5080  *>                                                              **
  5081  *> ** chg 09/08/23 vbc for missing statuses                     **
  5082  *> ** Chg 11/12/23 vbc for missing statuses                     **
  5083  *> ** Chg 10/04/25 vbc match all quotes & spacing/layout        **
  5084  *> ** chg to FREE format                                        **
  5085  *> ** Chg 24/08/25 vbc #91 description.                         **
  5086  *> ** Chg 15.11.25 vbc Replace all ' for "                      **
  5087  *> ***************************************************************
  5088  *>
  5089   EVALUATE PY-PR1-Status
  5090   WHEN "00" MOVE "Success                  " TO WS-Eval-Msg
  5091   WHEN "02" MOVE "Success Duplicate        " TO WS-Eval-Msg
  5092   WHEN "04" MOVE "Success Incomplete       " TO WS-Eval-Msg
  5093   WHEN "05" MOVE "Success Optional, Missing" TO WS-Eval-Msg
  5094   when "06" move "Multiple Records LS      " TO WS-Eval-Msg
  5095   WHEN "07" MOVE "Success No Unit          " TO WS-Eval-Msg
  5096   when "09" move "Success LS Bad Data      " TO WS-Eval-Msg
  5097   WHEN "10" MOVE "End Of File              " TO WS-Eval-Msg
  5098   WHEN "14" MOVE "Out Of Key Range         " TO WS-Eval-Msg
  5099   WHEN "21" MOVE "Key Invalid              " TO WS-Eval-Msg
  5100   WHEN "22" MOVE "Key Exists               " TO WS-Eval-Msg
  5101   WHEN "23" MOVE "Key Not Exists           " TO WS-Eval-Msg
  5102   WHEN "24" MOVE "Key Boundary violation   " TO WS-Eval-Msg
  5103   WHEN "30" MOVE "Permanent Error          " TO WS-Eval-Msg
  5104   WHEN "31" MOVE "Inconsistent Filename    " TO WS-Eval-Msg
  5105   WHEN "34" MOVE "Boundary Violation       " TO WS-Eval-Msg
  5106   WHEN "35" MOVE "File Not Found           " TO WS-Eval-Msg
  5107   WHEN "37" MOVE "Permission Denied        " TO WS-Eval-Msg
  5108   WHEN "38" MOVE "Closed With Lock         " TO WS-Eval-Msg
  5109   WHEN "39" MOVE "Conflict Attribute       " TO WS-Eval-Msg
  5110   WHEN "41" MOVE "Already Open             " TO WS-Eval-Msg
  5111   WHEN "42" MOVE "Not Open                 " TO WS-Eval-Msg
  5112   WHEN "43" MOVE "Read Not Done            " TO WS-Eval-Msg
  5113   WHEN "44" MOVE "Record Overflow          " TO WS-Eval-Msg
  5114   WHEN "46" MOVE "Read Error               " TO WS-Eval-Msg
  5115   WHEN "47" MOVE "Input Denied             " TO WS-Eval-Msg
  5116   WHEN "48" MOVE "Output Denied            " TO WS-Eval-Msg
  5117   WHEN "49" MOVE "I/O Denied               " TO WS-Eval-Msg
  5118   WHEN "51" MOVE "Record Locked            " TO WS-Eval-Msg
  5119   WHEN "52" MOVE "End-Of-Page              " TO WS-Eval-Msg
  5120   WHEN "57" MOVE "I/O Linage               " TO WS-Eval-Msg
  5121   WHEN "61" MOVE "File Sharing Failure     " TO WS-Eval-Msg
  5122   WHEN "71" MOVE "Bad Character LS         " TO WS-Eval-Msg
  5123   WHEN "91" MOVE "Feature Not Available    " TO WS-Eval-Msg
  5124            WHEN OTHER
  5125   MOVE "Unknown File PY-PR1-Status      " TO WS-
  5126  *>
  5127       END-EVALUATE.
  5128
  5129  *>>W Msg29 Caution: One or more replacing sources not found
  5130       exit     section.
ACS Cobol Xref v2.03.18          Dictionary File for PY900    24/03/2026  18:58:24:61                                  Page   96

  5131  *>
  5132   zz050-Validate-Date        section.
  5133  *>*********************************
  5134  *>
  5135  *>  Converts USA/Intl to UK date format for processing.
  5136  *>*******************************
  5137  *> Input:   WS-Test-Date
  5138  *> output:  U-Date/WS-Date as uk date format
  5139  *>          U-Bin not zero if valid date
  5140  *>
  5141  *>     move     WS-Test-Date to WS-Date.
  5142  *>     if       Date-Form = zero
  5143  *>              move 1 to Date-Form.
  5144  *>     if       Date-UK
  5145  *>              go to zz050-Test-Date.
  5146  *>     if       Date-USA                *> swap month and days
  5147  *>              move WS-Days  to WS-Swap
  5148  *>              move WS-Month to WS-Days
  5149  *>              move WS-Swap  to WS-Month
  5150  *>              go to zz050-Test-Date.
  5151  *>*>
  5152  *>*> So its International date format
  5153  *>*>
  5154  *>     move     "dd/mm/ccyy" to WS-Date.  *> swap Intl to UK form
  5155  *>     move     WS-Test-Date (1:4) to WS-Year.
  5156  *>     move     WS-Test-Date (6:2) to WS-Month.
  5157  *>     move     WS-Test-Date (9:2) to WS-Days.
  5158  *>*>
  5159  *> zz050-Test-Date.
  5160  *>     move     WS-Date to U-Date.
  5161  *>     move     zero to U-Bin.
  5162  *>     perform  maps04.
  5163  *>*>
  5164  *> zz050-exit.
  5165  *>     exit     section.
  5166  *>
  5167  *> zz060-Convert-Date        section.
  5168  *>********************************
  5169  *>
  5170  *>  Converts date in binary to UK/USA/Intl date format
  5171  *>****************************************************
  5172  *> Input:   U-Bin
  5173  *> output:  WS-Date as uk/US/Inlt date format
  5174  *>          U-Date & WS-Date = spaces if invalid date
  5175  *>
  5176  *>     perform  maps04.
  5177  *>     if       U-Date = spaces
  5178  *>              move spaces to WS-Date
  5179  *>              go to zz060-Exit.
  5180  *>     move     U-Date to WS-Date.
  5181  *>*>
  5182  *>     if       Date-Form = zero
  5183  *>              move 1 to Date-Form.
  5184  *>     if       Date-UK
ACS Cobol Xref v2.03.18          Dictionary File for PY900    24/03/2026  18:58:24:61                                  Page   97

  5185  *>              go to zz060-Exit.
  5186  *>     if       Date-USA                *> swap month and days
  5187  *>              move WS-Days  to WS-Swap
  5188  *>              move WS-Month to WS-Days
  5189  *>              move WS-Swap  to WS-Month
  5190  *>              go to zz060-Exit.
  5191  *>
  5192  *> So its International date format
  5193  *>
  5194  *>     move     "ccyy/mm/dd" to WS-Date.  *> swap Intl to UK form
  5195  *>     move     U-Date (7:4) to WS-Intl-Year.
  5196  *>     move     U-Date (4:2) to WS-Intl-Month.
  5197  *>     move     U-Date (1:2) to WS-Intl-Days.
  5198  *>*>
  5199  *> zz060-Exit.
  5200  *>     exit     section.
  5201  *>
  5202   zz070-Convert-Date          section.
  5203  *>**********************************
  5204  *>
  5205  *>  Converts date in To-Day to UK/USA/Intl date format using ACAS param
  5206  *>*********************************************************************
  5207  *> Input:   To-Day
  5208  *> output:  WS-Date as uk/US/Inlt date format
  5209  *>
  5210       move     To-Day to WS-Date.
  5211  *>
  5212       if       Date-Form = zero
  5213                move 1 to Date-Form.
  5214       if       Date-UK
  5215                go to zz070-Exit.
  5216       if       Date-USA                *> Swap month and days
  5217                move WS-Days  to WS-Swap
  5218                move WS-Month to WS-Days
  5219                move WS-Swap  to WS-Month
  5220                go to zz070-Exit.
  5221  *>
  5222  *> So its International date format
  5223  *>
  5224       move     "ccyy/mm/dd" to WS-Date.  *> Swap Intl to UK form
  5225       move     To-Day (7:4) to WS-Intl-Year.
  5226       move     To-Day (4:2) to WS-Intl-Month.
  5227       move     To-Day (1:2) to WS-Intl-Days.
  5228  *>
  5229   zz070-Exit.
  5230       exit     section.
  5231  *>
  5232   maps04.
  5233  *>******
  5234  *>
  5235       call     "maps04"  using  Maps03-WS.
  5236  *>
  5237   maps04-Exit. exit.
  5238  *>
