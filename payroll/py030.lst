    99  *>C  copy "selpyparam1.cob".
   100  *>
   101  *> Payroll param-1 (USA)
   102  *>
   103       select  PY-Param1-File  assign        File-47
   104                               access        dynamic
   105                               organization  is relative
   106                               relative key  is RRN
   107                               status        PY-PR1-Status.
   108  *>C  copy "selpyemp.cob".
