   109  *>
   110  *> Payroll Employee (USA)
   111  *>
   112       select  PY-Employee-File
   113                               assign               File-43
   114                               access               dynamic
   115                               organization         indexed
   116                               record key is        Emp-No
   117                               alternate record key Emp-Search-Name with duplicates
   118                               status               PY-Emp-Status.
   119  *>
   120  *>C  copy "selpyhrs.cob".
   121  *>
   122  *> Payroll Pay Hours (USA)
   123  *> Key in 2 parts, emp no and Trans-code
   124  *>
   125       select  PY-Pay-Transactions-File
   126                               assign        file-45
   127                               access        dynamic
   128                               organization  indexed
   129                               record key is Hrs-Key
   130                               status        PY-Hrs-Status.
