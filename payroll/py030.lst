  1952   zz050-Convert-Date          section.
  1953  *>**********************************
  1954  *>
  1955  *> Input:  WS-Temp-Date9.
  1956  *> Output: WS-Date as 99/99/9999
  1957  *>
  1958       move     "99/99/9999" to WS-Date.
  1959       if       PY-PR1-Date-Format = 2    *> USA mm/dd/ccyy
  1960                string   WS-Temp-Month "/" WS-Temp-Days "/" WS-Temp-Year
  1961                         into WS-Date
  1962       else
  1963                string   WS-Temp-Days "/" WS-Temp-Month "/" WS-Temp-Year
  1964                         into WS-Date.
  1965  *>
  1966       exit     section.
  1967  *>
  1968   zz070-Convert-Date          section.
  1969  *>**********************************
  1970  *>
  1971  *>  Converts date in WSE-Date to UK/USA/Intl date format using current-date
  1972  *>*************************************************************************
  1973  *> Input:   WSE-Date via CURRENT-DATE
  1974  *> output:  WS-Date as uk/US/Inlt date format
  1975  *>
  1976  *> first create in UK date
  1977       move     WSE-Year  to WS-Year.
  1978       move     WSE-Month to WS-Month.
  1979       move     WSE-Days  to WS-Days.
  1980
  1981  *>
  1982       if       Date-Form = zero
  1983                move 1 to Date-Form.
  1984  *>
  1985       if       Date-UK          *> nothing to do as in UK format
  1986                go to zz070-Exit.
  1987       if       Date-USA                *> Swap month and days
  1988                move WS-Days  to WS-Swap
  1989                move WS-Month to WS-Days
  1990                move WS-Swap  to WS-Month
  1991                go to zz070-Exit.
  1992  *>
  1993  *> So its International date format
  1994  *>
  1995       move     "ccyy/mm/dd" to WS-Date.  *> Swap to Intl
  1996       move     WSE-Year  to WS-Intl-Year.
  1997       move     WSE-Month to WS-Intl-Month.
  1998       move     WSE-Days  to WS-Intl-Days.
ACS Cobol Xref v2.03.18          Dictionary File for PY030    09/04/2026  19:12:41:72                                  Page   38

  1999  *>
  2000   zz070-Exit.
  2001       exit     section.
  2002  *>
