  1696  *>
  1697  *> Terminal-Sizing.
  1698  *>
  1699       perform  forever
  1700                accept   WS-Env-Lines   from lines
  1701                if       WS-Env-Lines < 28
  1702                         display  SY010    at 0101 with erase eos
  1703                         accept   WS-Reply at 0133
  1704                         move     8 to WS-Term-Code
  1705                         exit perform cycle
  1706                end-if
  1707                accept   WS-Env-Columns from Columns
  1708                if       WS-Env-Columns < 80
  1709                         display  SY013    at 0101 with erase eos
  1710                         accept   WS-Reply at 0130
  1711                         move     8 to WS-Term-Code
  1712                         exit perform cycle
  1713                end-if
  1714       end-perform.
