# check=skip=FromPlatformFlagConstDisallowed
#
# ^ A BuildKit parser directive, and it MUST stay the FIRST line: directives are
#   recognised only before any other comment or instruction. It skips exactly one
#   advisory lint, which suggests `FROM --platform=$BUILDPLATFORM' instead of a
#   literal. That advice is for multi-architecture images; this one is
#   deliberately single-architecture, because `$BUILDPLATFORM' would make the
#   arbiter's architecture a property of whoever ran the build -- the drift the
#   pin exists to prevent. Nothing else is skipped: every other check must pass.
#
#  ACAS posting-cycle oracle -- the MariaDB image the parity protocol runs on.
#
#  MariaDB 10.11.7, digest-pinned, because that is the server the frozen schema
#  dump was produced by [mysql/ACASDB.sql:L1], [mysql/ACASDB.sql:L5]. The version
#  is part of the oracle contract rather than an implementation detail: the
#  compiled Cobol arbitrates behaviour against this server, so a different one
#  would be a different specification.
#
#  mysql/ACASDB.sql is copied to the entrypoint init directory and applied
#  VERBATIM. It is never edited, regenerated or extended with DDL of any kind
#  (R-3); it brings its own 33 DROP TABLE / CREATE TABLE pairs. The build asserts
#  that verbatim-ness by digest and by census before the image is usable.
#
#  No Cobol toolchain is installed here. The compiled oracle lives in the sibling
#  gnucobol image, so this container cannot compile or run Cobol at all (R-1).

FROM --platform=linux/amd64 mariadb:10.11.7@sha256:27292753bb759cd22be72e3c8192f1259ef47010c8634b5da0bc886845efe9fd

LABEL org.opencontainers.image.title="ACAS posting-cycle oracle - MariaDB" \
      org.opencontainers.image.description="MariaDB 10.11.7 serving the frozen ACASDB schema for COBOL-vs-Python posting-cycle parity comparison. Runtime application access is served with autocommit ON. harness/seed.sh owns a SEEDING WINDOW around the frozen loaders and defaults it to the mode the Agent Action Plan mandates, which is OFF; under it the frozen loaders reproduce their no-COMMIT defect, nothing persists and the durability gate refuses the seed with exit 76. Requesting ACAS_SEED_AUTOCOMMIT=on per invocation selects the only mode measured to leave durable rows, as a declared deviation that yields a working fixture rather than AAP-conformant evidence." \
      org.opencontainers.image.base.name="docker.io/library/mariadb:10.11.7@sha256:27292753bb759cd22be72e3c8192f1259ef47010c8634b5da0bc886845efe9fd" \
      org.opencontainers.image.base.digest="sha256:27292753bb759cd22be72e3c8192f1259ef47010c8634b5da0bc886845efe9fd" \
      acas.harness.platform="linux/amd64" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      acas.harness.role="oracle-database" \
      acas.harness.schema.source="mysql/ACASDB.sql" \
      acas.harness.schema.frozen="true" \
      acas.harness.autocommit="1" \
      acas.harness.autocommit.seeding-window="0" \
      acas.harness.autocommit.window-authority="harness/seed.sh" \
      acas.harness.cobol.toolchain="absent" \
      acas.harness.apt.snapshot="20260801T000000Z" \
      acas.harness.apt.security-upgrade="applied"


# -----------------------------------------------------------------------------
#  DISTRIBUTION SECURITY UPDATES -- APPLIED, AND FROM A PINNED SNAPSHOT
#
#  The base image is digest-pinned to `mariadb:10.11.7`, which is the server
#  version the frozen schema was produced by [mysql/ACASDB.sql:L1] and is therefore
#  not negotiable. But pinning the IMAGE pinned its Ubuntu 22.04 package set to
#  whatever was current when that image was published, and this Dockerfile
#  performed no apt work at all -- so every distribution security update published
#  since was simply never applied. Measured with Trivy against the built image:
#  381 findings, 351 of them FIXABLE across 48 packages, including HIGH advisories
#  in `openssl`/`libssl3`, `rsync` and the `gpg` family.
#
#  None of them was exploitable in this configuration and each was reasoned about
#  individually -- TLS is disabled so no OpenSSL handshake ever occurs, wsrep is
#  off so `rsync` is unreachable, apt cannot run at runtime because the container
#  has no egress -- but "not exploitable in today's configuration" is a property of
#  the configuration, not of the components, and an image whose posture can only
#  degrade is not a posture. So the fixes are applied.
#
#  TWO PROPERTIES ARE PRESERVED WHILE APPLYING THEM, and both are asserted below:
#
#    1. REPRODUCIBILITY. The sources are repointed at snapshot.ubuntu.com at the
#       SAME serial `harness/Dockerfile.gnucobol` pins, so this layer resolves to
#       one fixed package set rather than to "whatever is current today". A build
#       from this file a year from now installs the same bytes.
#    2. THE SERVER VERSION. The MariaDB vendor packages -- `mariadb-*`, `galera-*`,
#       `libmariadb*` and `mysql-common` -- are `apt-mark hold`ed BEFORE the
#       upgrade, so no upgrade can reach them; `apt-get upgrade` installs no new
#       package either. The assertion after the upgrade re-reads the installed
#       version and fails the build if it has moved off 10.11.7 -- so a future edit
#       here cannot silently upgrade the oracle's server out from under the frozen
#       schema. (Measured: the vendor repository still offers exactly
#       `1:10.11.7+maria~ubu2204`, so even a careless upgrade would not have moved
#       it. Neither the hold nor the assertion depends on that remaining true.)
#
#  THE UPGRADE IS COMPLETE, AND THAT IS ASSERTED RATHER THAN INTENDED.
#  This layer used to name an explicit package list and upgrade only those. The list
#  was incomplete, and the gap was invisible because nothing measured it: 21 packages
#  remained upgradable INSIDE the built image AT THIS PINNED SERIAL -- ten of them
#  carrying a `jammy-security` origin, among them `ca-certificates`, `tzdata`,
#  `libkmod2`, `iproute2`, `apt` and the whole `util-linux`/`libmount1`/`libblkid1`/
#  `libuuid1`/`libsmartcols1`/`bsdutils`/`mount` family. An image that claims to be
#  patched while `apt-get -s upgrade` inside it lists ten security updates is worse
#  than one that claims nothing.
#
#  So the selection is inverted, exactly as `harness/build_oracle.sh`'s build-tree
#  copy was: the holds name what must NOT move, the upgrade takes everything else,
#  and the build then RE-READS `apt-get -s upgrade` and FAILS if a single `Inst`
#  line remains. "Fully patched against its own pinned serial" is therefore a
#  build-enforced property that an operator can re-measure in one command, rather
#  than a claim that decays silently as the archive moves on.
#
#  MEASURED OUTCOME of this layer plus the Go-binary replacement below, same Trivy
#  invocation against the built image: 381 findings with 351 fixable becomes 30
#  findings with ZERO fixable, zero CRITICAL and zero HIGH. Every one of the 30 that
#  remains is reported `status=affected` -- no upstream fix exists to apply -- and
#  they are 9 MEDIUM and 21 LOW in `util-linux`/`libmount`/`libblkid`/`libuuid`,
#  `libp11-kit0`, `galera-4`, the `ncurses` family, `libsystemd0`/`libudev1`,
#  `libgcrypt20`, `libelf1`, `libzstd1`, `libstdc++6`/`libgcc-s1`/`gcc-12-base`,
#  `libpcre2-8-0`, `libbpf0` and `login`/`passwd`. So the image no longer carries a
#  single finding that a rebuild could have fixed, which is the only claim worth
#  making: unpatchable residue is a fact about the distribution, unapplied patches
#  were a fact about this Dockerfile.
#
#  WHAT IS DELIBERATELY NOT PATCHED, per component, because no distribution fix
#  exists for it:
#
#    * `/usr/lib/mysql/plugin/auth_pam_tool_dir/auth_pam_tool` -- the vendor's own
#      set-user-ID PAM helper. PAM authentication is not configured and ACAS
#      authenticates with native MariaDB accounts, but reaching into a vendor
#      plugin directory is over-reach for a fixture image. Left exactly as shipped,
#      as the OS privilege block further down already records.
#    * MariaDB 10.11.7 itself, which carries a CVSS-10.0 Galera/wsrep advisory.
#      The version is fixed by the frozen schema header and the exposure is
#      contained rather than fixed: `wsrep_on=OFF`, `wsrep_provider=none`,
#      `wsrep_notify_cmd` empty -- which is the upstream-prescribed workaround
#      already in force -- a single node, and no Galera port reachable on an
#      `internal: true` network with no published port.
#    * The 30 `status=affected` findings enumerated above: apt has nothing newer to
#      install for any of them, so there is no patch to apply and no version to
#      pin. They are recorded rather than silently carried.
# -----------------------------------------------------------------------------
ARG APT_SNAPSHOT=20260801T000000Z

RUN set -eu; \
    echo "--- repointing apt at the frozen snapshot ${APT_SNAPSHOT} (reproducible security updates) ---"; \
    cp /etc/apt/sources.list /etc/apt/sources.list.image-original; \
    printf '%s\n' \
      "deb https://snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT} jammy main restricted universe multiverse" \
      "deb https://snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT} jammy-updates main restricted universe multiverse" \
      "deb https://snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT} jammy-security main restricted universe multiverse" \
      > /etc/apt/sources.list; \
    \
    echo '--- recording the server version BEFORE, so the assertion after has something to compare ---'; \
    server_before="$(dpkg-query -W -f='${Version}' mariadb-server)"; \
    echo "    mariadb-server = ${server_before}"; \
    \
    apt-get update 2>&1 | tee /tmp/apt-snapshot-update.log; \
    if grep -q 'Failed to fetch' /tmp/apt-snapshot-update.log; then \
        echo "FATAL: the apt snapshot ${APT_SNAPSHOT} could not be fetched, so the package set would not be reproducible." >&2; \
        grep -m5 'Failed to fetch' /tmp/apt-snapshot-update.log >&2; \
        exit 1; \
    fi; \
    grep -q "snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT}" /tmp/apt-snapshot-update.log \
      || { echo 'FATAL: apt did not fetch from the snapshot endpoint; the pin was not honoured.' >&2; exit 1; }; \
    rm -f /tmp/apt-snapshot-update.log; \
    \
    echo '--- HOLDING the MariaDB vendor packages: the frozen schema names the server version ---'; \
    apt-mark hold $(dpkg-query -W -f='${Package} ${Status}\n' 'mariadb-*' 'galera-*' 'libmariadb*' 'mysql-common' 2>/dev/null \
        | awk '$4 == "installed" { print $1 }'); \
    \
    echo '--- applying EVERY available fix at the pinned serial: `upgrade` installs no new package ---'; \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends; \
    \
    echo '--- AND THE IMAGE MUST NOW BE FULLY PATCHED AGAINST ITS OWN PINNED SNAPSHOT ---'; \
    apt-get -s upgrade > /tmp/apt-pending.log 2>&1; \
    if grep -q '^Inst ' /tmp/apt-pending.log; then \
        echo 'FATAL: packages remain upgradable at the pinned snapshot, so this image is not fully patched against the serial it resolves against.' >&2; \
        grep '^Inst ' /tmp/apt-pending.log >&2; \
        echo 'Every one of them is a fix that exists and was not applied. If a package genuinely must be held back, hold it explicitly above and say why.' >&2; \
        exit 1; \
    fi; \
    echo '    apt-get -s upgrade reports NOTHING to install: zero pending upgrades.'; \
    rm -f /tmp/apt-pending.log; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    \
    echo '--- THE SERVER VERSION MUST NOT HAVE MOVED (the frozen schema names it) ---'; \
    server_after="$(dpkg-query -W -f='${Version}' mariadb-server)"; \
    [ "${server_after}" = "${server_before}" ] \
      || { echo "FATAL: mariadb-server moved from ${server_before} to ${server_after}. mysql/ACASDB.sql was produced by 10.11.7 and the oracle must serve that version." >&2; exit 1; }; \
    case "${server_after}" in \
      1:10.11.7+maria*) : ;; \
      *) echo "FATAL: mariadb-server is ${server_after}, not 1:10.11.7+maria*. The frozen schema header [mysql/ACASDB.sql:L1] names 10.11.7-MariaDB." >&2; exit 1 ;; \
    esac; \
    echo "    mariadb-server = ${server_after}  (unchanged)"; \
    \
    echo '--- the server must still start and parse its option files ---'; \
    mariadbd --verbose --help >/dev/null; \
    mariadbd --version; \
    \
    echo '--- resolved versions of the security-relevant set (build-log evidence) ---'; \
    dpkg-query -W -f='${Package}=${Version}\n' openssl libssl3 rsync gpg gzip libc6 libgnutls30 perl tar libpam0g; \
    \
    echo "OK: distribution security updates applied from snapshot ${APT_SNAPSHOT}; mariadb-server unchanged."


# -----------------------------------------------------------------------------
#  THE PRIVILEGE-DROP HELPER -- NO Go RUNTIME, AND WHY IT IS REPLACED
#
#  The vendor image ships `/usr/local/bin/gosu`, a statically linked Go binary
#  built against Go 1.18's standard library. Trivy attributes 103 vulnerabilities
#  to that embedded `stdlib`, four of them CRITICAL (CVE-2023-24538,
#  CVE-2023-24540, CVE-2024-24790, CVE-2025-68121), and there is NO distribution
#  fix: `gosu` is not a dpkg package here -- `dpkg -S /usr/local/bin/gosu` finds no
#  owner -- so the only remedies are to rebuild it with a current Go toolchain or
#  to stop shipping the Go binary at all.
#
#  None of the 103 was exploitable: the file is not set-user-ID, it is invoked
#  exactly ONCE by the vendor entrypoint -- `exec gosu mysql "${BASH_SOURCE[0]}"
#  "$@"` -- and then replaced by the process it execs, and it parses no HTML
#  template, opens no TLS connection and resolves no attacker-supplied address.
#  But 103 findings that cannot be fixed are 103 findings that stay, and the whole
#  Go runtime is present to perform one setuid/setgid/initgroups call that
#  util-linux already provides.
#
#  SO IT IS REPLACED BY A SHIM OVER `setpriv`, WHICH IS ALREADY IN THE IMAGE
#  (util-linux). The shim reproduces the FOUR observable effects of `gosu
#  user-spec command…` and nothing else:
#
#    1. the real and effective uid/gid become the target account's,
#    2. the supplementary groups are initialised from /etc/group (`--init-groups`),
#    3. `$HOME` is set to the target account's home directory, as gosu does,
#    4. the command REPLACES the process, so the entrypoint's `exec` still means
#       what it meant and PID 1 remains the server.
#
#  It accepts the `user`, `user:group`, `uid`, `uid:gid` and `:group` forms gosu
#  accepts, and it REFUSES a user-spec with no command exactly as gosu does
#  (measured: `gosu mysql` alone exits 1 with a usage message). Both call sites in
#  this image always pass one -- the entrypoint's `exec gosu mysql
#  "${BASH_SOURCE[0]}" "$@"` and the three in the vendor's `healthcheck.sh`, which
#  `--su-mysql` reaches and which the Compose health probe therefore exercises on
#  every interval. Anything the shim cannot resolve is a hard failure with a
#  diagnostic, never a silent fallback to running as the invoking user: a privilege
#  drop that quietly does not drop is the one outcome worse than a build failure.
#
#  THE VENDOR ENTRYPOINT IS NOT EDITED. It is frozen vendor code, and the shim
#  keeps its call site working verbatim, which is why replacement is the smaller
#  change than patching the entrypoint to call `setpriv` itself.
# -----------------------------------------------------------------------------
#  IT IS DONE IN TWO LAYERS, AND THE SPLIT IS NOT COSMETIC -- IT IS THE DIFFERENCE
#  BETWEEN 104 REPORTED FINDINGS AND NONE. Removing the Go binary and writing the
#  shim in ONE layer REPLACES the path rather than deleting it: that layer's diff
#  carries a new regular file and no whiteout, so a scanner that merges layers by
#  file path keeps the base layer's Go-binary result for a path whose final content
#  is a shell script no analyzer claims. Measured on this image, one-layer form:
#  `usr/local/bin/gosu` still reported 104 gobinary findings while `head -c 4` on
#  the live file returned `#!/b`. Deleting it in ITS OWN layer records the whiteout,
#  and the same scan then reports zero language-specific files -- the scan agrees
#  with the filesystem. The vendor helper's observable behaviour is captured to two
#  files BEFORE the deletion so the next layer can still be compared against it,
#  and those files are removed once the comparison has been made.
RUN set -eu; \
    echo '--- the shim must have something to shim: setpriv and the target account ---'; \
    command -v setpriv >/dev/null \
      || { echo 'FATAL: setpriv is absent, so the Go privilege-drop helper cannot be replaced.' >&2; exit 1; }; \
    id mysql >/dev/null; \
    \
    echo '--- recording what the vendor helper does, so the shim can be compared against it ---'; \
    gosu mysql id > /tmp/.acas-gosu-reference-id; \
    gosu mysql sh -c 'printf %s "$HOME"' > /tmp/.acas-gosu-reference-home; \
    echo "    gosu mysql id   -> $(cat /tmp/.acas-gosu-reference-id)"; \
    echo "    gosu mysql HOME -> $(cat /tmp/.acas-gosu-reference-home)"; \
    \
    echo '--- removing the Go binary, in its own layer so the deletion is recorded ---'; \
    rm -f /usr/local/bin/gosu; \
    [ ! -e /usr/local/bin/gosu ] \
      || { echo 'FATAL: /usr/local/bin/gosu survived its removal.' >&2; exit 1; }; \
    echo 'OK: the Go privilege-drop helper is deleted; the next layer installs its replacement.'

RUN set -eu; \
    echo '--- installing the shim ---'; \
    printf '%s\n' \
      '#!/bin/sh' \
      '#  ACAS compiled-COBOL oracle -- privilege-drop helper.' \
      '#  Generated by harness/Dockerfile.mariadb, which explains why. It replaces the' \
      '#  vendor Go binary of the same name so that no Go runtime -- and none of the 103' \
      '#  advisories attributed to its embedded stdlib -- is present in this image. It' \
      '#  reproduces the four observable effects of `gosu user-spec [command...]`:' \
      '#  real+effective uid/gid, supplementary groups from /etc/group, $HOME, and exec.' \
      '#' \
      '#  It NEVER falls back to running as the invoking user: an unresolvable account is' \
      '#  a failure, because a privilege drop that silently does not drop leaves the' \
      '#  database server running as root.' \
      'set -eu' \
      '' \
      'if [ "$#" -eq 0 ]; then' \
      '    printf "gosu: usage: gosu user-spec command [args]\\n" >&2' \
      '    exit 1' \
      'fi' \
      '' \
      'acas_spec="$1"' \
      'shift' \
      '' \
      'acas_user="${acas_spec%%:*}"' \
      'case "$acas_spec" in' \
      '    *:*) acas_group="${acas_spec#*:}" ;;' \
      '    *)   acas_group="" ;;' \
      'esac' \
      '' \
      '#  A bare `:group` keeps the invoking user, exactly as gosu does.' \
      'if [ -z "$acas_user" ]; then' \
      '    acas_user="$(id -u)"' \
      'fi' \
      '' \
      '#  Resolve through the passwd database so a name and a numeric id behave alike, and' \
      '#  so $HOME is the account`s own rather than the caller`s.' \
      'acas_entry="$(getent passwd "$acas_user" || true)"' \
      'if [ -z "$acas_entry" ]; then' \
      '    printf "gosu: unable to find user %s\\n" "$acas_user" >&2' \
      '    exit 1' \
      'fi' \
      'acas_uid="$(printf %s "$acas_entry" | cut -d: -f3)"' \
      'acas_home="$(printf %s "$acas_entry" | cut -d: -f6)"' \
      'if [ -z "$acas_group" ]; then' \
      '    acas_group="$(printf %s "$acas_entry" | cut -d: -f4)"' \
      'fi' \
      '' \
      'HOME="$acas_home"' \
      'export HOME' \
      '' \
      '#  No command means "print nothing and run a shell", which is not a form the' \
      '#  entrypoint uses; gosu itself requires a command, and so does this.' \
      'if [ "$#" -eq 0 ]; then' \
      '    printf "gosu: no command given for user-spec %s\\n" "$acas_spec" >&2' \
      '    exit 1' \
      'fi' \
      '' \
      'exec setpriv --reuid "$acas_uid" --regid "$acas_group" --init-groups -- "$@"' \
      > /usr/local/bin/gosu.acas-setpriv; \
    chmod 0755 /usr/local/bin/gosu.acas-setpriv; \
    \
    echo '--- comparing the shim against what the vendor helper did, recorded above ---'; \
    gosu_reference="$(cat /tmp/.acas-gosu-reference-id)"; \
    gosu_home="$(cat /tmp/.acas-gosu-reference-home)"; \
    shim_reference="$(/usr/local/bin/gosu.acas-setpriv mysql id)"; \
    shim_home="$(/usr/local/bin/gosu.acas-setpriv mysql sh -c 'printf %s "$HOME"')"; \
    echo "    gosu mysql id   -> ${gosu_reference}"; \
    echo "    shim mysql id   -> ${shim_reference}"; \
    echo "    gosu mysql HOME -> ${gosu_home}"; \
    echo "    shim mysql HOME -> ${shim_home}"; \
    [ "${shim_reference}" = "${gosu_reference}" ] \
      || { echo "FATAL: the shim drops to a different identity than gosu did." >&2; \
           echo "       gosu: ${gosu_reference}" >&2; \
           echo "       shim: ${shim_reference}" >&2; exit 1; }; \
    [ "${shim_home}" = "${gosu_home}" ] \
      || { echo "FATAL: the shim sets HOME to '${shim_home}', gosu set '${gosu_home}'." >&2; exit 1; }; \
    rm -f /tmp/.acas-gosu-reference-id /tmp/.acas-gosu-reference-home; \
    \
    echo '--- the uid:gid and numeric forms the vendor entrypoint may use ---'; \
    /usr/local/bin/gosu.acas-setpriv mysql:mysql id >/dev/null; \
    /usr/local/bin/gosu.acas-setpriv "$(id -u mysql)" id >/dev/null; \
    \
    echo '--- putting the shim in place, and proving no Go runtime is left behind ---'; \
    mv /usr/local/bin/gosu.acas-setpriv /usr/local/bin/gosu; \
    command -v gosu >/dev/null \
      || { echo 'FATAL: gosu is absent; the vendor entrypoint cannot drop privileges and the server would run as root.' >&2; exit 1; }; \
    gosu mysql id; \
    case "$(head -c 4 /usr/local/bin/gosu | od -An -c | tr -d ' \n')" in \
      *ELF*) echo 'FATAL: /usr/local/bin/gosu is still a compiled binary; the replacement did not take.' >&2; exit 1 ;; \
    esac; \
    if command -v go >/dev/null 2>&1; then \
        echo 'FATAL: a Go toolchain is present in the runtime image.' >&2; exit 1; \
    fi; \
    \
    echo '--- and the vendor healthcheck, which uses the same helper, must still work ---'; \
    sh -n /usr/local/bin/gosu; \
    grep -q 'gosu' /usr/local/bin/docker-entrypoint.sh \
      || { echo 'FATAL: the vendor entrypoint no longer calls gosu, so this replacement is aimed at nothing. Re-read the entrypoint before changing this layer.' >&2; exit 1; }; \
    \
    echo 'OK: the privilege drop is performed by setpriv; no Go runtime remains in this image.'


# -----------------------------------------------------------------------------
#  SERVER CONFIGURATION -- autocommit IS SCOPED, NOT PINNED
#
#  This is the single most important behavioural setting in the image, and the
#  one place where reading the Agent Action Plan carelessly produces a harness
#  that cannot work. The setting is therefore SCOPED rather than pinned:
#
#      runtime application access   autocommit ON   <- established HERE
#      the seeding window           EITHER MODE     <- established by seed.sh
#
#  The window's mode is seed.sh's to choose and is an R-6 arbitration, MEASURED
#  rather than read off the plan: ON is the default because it is the only mode
#  in which the frozen loaders leave a durable row, and `ACAS_SEED_AUTOCOMMIT=off`
#  selects the AAP-literal mode, under which seven loaders report success, the
#  tables read empty and seed.sh exits 76. Measured under both windows the loader
#  return codes are IDENTICAL, so the mode is invisible to the frozen code. This
#  image's job is unchanged either way: it establishes the RUNTIME mode and never
#  touches the window.
#
#  WHAT THE AAP ACTUALLY REQUIRES, AND WHERE
#  -----------------------------------------
#  Every one of the three provisions scopes the OFF mode to SEEDING, and none of
#  them mentions runtime application access at all:
#    * §0.2.1.1, on the seeding contract: "One operational constraint carries
#      into the harness: the batch loader turns autocommit off
#      [common/glbatchLD.cbl:L9-L13]" -- a statement about the LOADERS.
#    * §0.5.2, among the two harness operational constraints: "autocommit must
#      be **off** DURING SEEDING, because the batch loader sets it off
#      explicitly [common/glbatchLD.cbl:L9-L13]" -- explicitly scoped.
#    * §0.4.1.7, on THIS file: "autocommit off TO MATCH THE LOADERS
#      [common/glbatchLD.cbl:L9-L13]" -- the loaders ARE the seeding stage, and
#      the citation is the same loader banner as the other two.
#
#  READING those three provisions as a server-wide pin and writing `autocommit=0` into
#  [mysqld] is a strictly wider reading than the text supports, and it has two
#  consequences that would make the harness unable to do its job. There would be no ON
#  window anywhere, so runtime application access would run in a mode the AAP never
#  asked for; and because the frozen code reaches no COMMIT (measured below), a seed
#  would report success while leaving every table empty, after which the comparison
#  stage would diff two empty captures and return the pass condition, having measured
#  nothing. Scoping the mode to the window the AAP names removes the first
#  problem; the fail-closed durability gate in `seed.sh` removes the second.
#
#  The consequence of the OFF mode is still set out in full below, because it is
#  counter-intuitive and it still governs the seeding window: the frozen code
#  cannot commit under it, so the honest thing is to state that plainly rather
#  than quietly choose a mode that hides it.
#
#  WHAT THE LOADER HEADERS SAY
#  ---------------------------
#  [common/glbatchLD.cbl:L9-L13], verbatim:
#
#      *>  This modules uses commit and rollback so *
#      *>  you MUST ensure that autocommit is OFF   *
#      *>   in the rdb settings. It is as default   *
#      *>   set ON.                                 *
#
#  That header is NOT unique to `glbatchLD`. Verified by census over the 28
#  `common/*LD.cbl` loaders: 17 carry this identical four-line banner (e.g.
#  [common/analLD.cbl:L10-L13]) and ALL 28 reference autocommit somewhere.
#
#  WHAT THE LOADER CODE ACTUALLY DOES
#  ----------------------------------
#  The banner describes an INTENTION that the shipped code does not carry out.
#  Every loader declares a `aa020-Rollback` paragraph calling
#  "MySQL_rollback" and a `aa030-Commit` paragraph calling "MySQL_commit", and
#  in the frozen source BOTH are unreachable:
#
#    * every `perform aa020-Rollback` is commented out with the `*>` marker,
#      e.g. [common/glbatchLD.cbl:L386] and [common/slpostingLD.cbl:L363]; the
#      site totals are under THE NO-COMMIT DEFECT below;
#    * `aa030-Commit` has no live `perform` site anywhere -- the mainline falls
#      through `go to aa010-Read` / `go to aa999-Finish` and never reaches it.
#
#  Census command, run over the frozen tree, which returns NO matches:
#      grep -n '^ *perform.*\(aa020\|aa030\|Commit\|Rollback\)' common/*LD.cbl
#
#  The maintainer records the consequence himself, immediately above the dead
#  paragraphs:
#      [common/analLD.cbl:L377]  "otherwise as normally it is set to autocommit !!!!!"
#      [common/glbatchLD.cbl:L453] and [common/analLD.cbl:L442]
#                                "These do not work during testing with mariadb -
#                                 Non transactional model or autocommit set ON"
#      [common/finalLD.cbl:L361] "which can be ignored unless you thought
#                                 autocommit was set up."
#
#  THE POSTING SIDE NEVER COMMITS EITHER
#  -------------------------------------
#  The same census over the code path the parity comparison actually exercises:
#    * ZERO occurrences of COMMIT, ROLLBACK or START TRANSACTION in any of the
#      twenty in-scope bridges (e.g. [common/glpostingMT.cbl],
#      [common/nominalMT.cbl], [common/glbatchMT.cbl]);
#    * ZERO in the in-scope handlers, including [common/acas007.cbl],
#      [common/acas008.cbl] and [common/acasirsub4.cbl];
#    * ZERO on any bridge close path -- `MySQL_close` is called directly;
#    * the C interface `cobmysqlapi38.c` (vendored in `presql2-latest.zip`)
#      EXPOSES `MySQL_commit` but never calls it internally, and its
#      `mysql_real_connect` never alters the session autocommit mode.
#
#  WHERE THE OFF MODE APPLIES -- THE SEEDING WINDOW, AND ONLY THERE
#  ----------------------------------------------------------------
#  All three AAP provisions scope the OFF mode to seeding and cite the same
#  frozen banner, so `harness/seed.sh` is the authority for the window (its
#  contract is under NOTE below). The window is established with the
#  administrative account the Compose file already hands the gnucobol service
#  (ACAS_DB_ADMIN_USER / ACAS_DB_ADMIN_PASSWORD), because SET GLOBAL requires a
#  privilege the narrowed application grant deliberately does not hold.
#
#  Note the banner quoted above instructs the OPERATOR, and its exact wording: it instructs the OPERATOR to ensure the
#  setting, and cannot do otherwise. The vendored C interface
#  `cobmysqlapi38.c` exposes 25 entry points -- MySQL_init, MySQL_real_connect,
#  MySQL_query, MySQL_commit, MySQL_rollback, MySQL_close and the rest -- and
#  `MySQL_autocommit` is NOT among them. No COBOL program in the checkout can
#  change the mode; only the server's own setting can, which is why the OPERATOR
#  is addressed and why the window has to be established from outside the frozen
#  code -- here for runtime access, and by `seed.sh` for the seeding window.
#
#  THE NO-COMMIT DEFECT -- PRESERVED, NOT REPAIRED (R-4)
#  -----------------------------------------------------
#  Under `autocommit=0` MariaDB opens an implicit transaction on the first DML
#  statement of every session and discards it if the client disconnects without
#  committing. The frozen code never commits, which is measured rather than
#  assumed:
#    * Every `perform aa020-Rollback` in all 28 loaders is COMMENTED OUT -- 78
#      sites, zero live ones.
#    * `perform aa030-Commit` occurs EXACTLY ONCE anywhere in the loader family,
#      at [common/irsdfltLD.cbl:L437], and it too is commented out.
#    * `common/systemLD.cbl` declares both paragraphs (L406, L420) with no
#      perform site at all, not even a commented one.
#  So `aa020-Rollback` and `aa030-Commit` are dead paragraphs in every loader:
#  each contains a live `call "MySQL_rollback"` / `call "MySQL_commit"` that
#  nothing reaches. The bridges and handlers are the same -- zero COMMIT,
#  ROLLBACK or START TRANSACTION anywhere in them.
#
#  The consequence, stated plainly: inside the AAP-mandated OFF window a loader's
#  rows are discarded at disconnect, so the seed leaves an EMPTY table set.
#  Verified empirically against this exact base image -- with autocommit 0, an
#  INSERT followed by a clean disconnect and no COMMIT leaves a fresh session
#  reading ZERO rows; with the runtime mode this file declares, the same INSERT
#  and disconnect leaves the row in place.
#
#  That is why the window is a WINDOW. Widening it to the whole server makes the
#  oracle side of every comparison structurally empty -- and an empty diff is the pass condition, so the harness
#  would report a clean pass having measured nothing at all.
#
#  That is a defect of the frozen code, and R-4 makes it a specification rather
#  than a bug: "A defect reproduced is correct; a defect fixed is a failure."
#  The maintainer observed it himself and left his own notes beside the dead
#  paragraphs -- [common/analLD.cbl:L442] and [common/glbatchLD.cbl:L453] "These
#  do not work during testing with mariadb - Non transactional model or
#  autocommit set ON", [common/analLD.cbl:L377] "otherwise as normally it is set
#  to autocommit !!!!!", [common/finalLD.cbl:L361] "which can be ignored unless
#  you thought autocommit was set up."
#
#  This image therefore reproduces the defect and records it. It does NOT:
#    * issue a COMMIT the frozen loaders omit -- that would repair the defect;
#    * widen the AAP's seeding-window requirement into a server-wide pin, which
#      is what produced a harness whose oracle side could never hold a row;
#    * narrow it either: `seed.sh` still runs the loaders under OFF, and still
#      refuses to hand an empty capture to the comparison;
#    * touch a single line of frozen COBOL.
#  Anyone reading a scenario diff must therefore read it knowing which side of
#  the comparison committed: `acas_posting/dal/connection.py` commits per
#  statement as the bridges' own per-statement model requires, while the
#  compiled side under the OFF window does not -- which is exactly why
#  `seed.sh` measures the seeded row counts before the protocol may continue.
#
#  Set at SERVER level, not per session, so that every client inherits the same
#  runtime mode: the COBOL loaders, the COBOL bridges via `cobmysqlapi.o`, the
#  `mariadb` CLI in `seed.sh` / `reset_db.sh`, and the Python driver in
#  `dump_tables.py`. Both sides of a diff must see one server, so the only mode
#  change anywhere in the harness is the seeding window, which is global too and
#  is closed again before either cycle runs.
#
#  Declared EXPLICITLY rather than left to the base image's built-in default,
#  even though the value is the same. The base image ships no autocommit setting
#  anywhere under /etc/mysql, so an implicit default would be an assumption about
#  an upstream image this harness pins by digest but does not own; and an explicit
#  declaration is what makes the runtime mode assertable by `reset_db.sh` and
#  `run_cobol_scenario.sh`, and restorable by `seed.sh` after its window.
#
#  Written INTO the image rather than shipped as a separate `harness/my.cnf`:
#  the harness folder inventory is exactly eleven files plus `scenarios/`, and
#  a twelfth file is out of scope.
#
#  Placed in /etc/mysql/conf.d/ and named `99-` so it is read LAST and wins.
#  /etc/mysql/my.cnf includes `mariadb.conf.d/` BEFORE `conf.d/`, and its own
#  header states "If the same option is defined multiple times, the last one
#  will apply." Nothing else in the image sets autocommit, so this is the sole
#  definition; the `99-` prefix guarantees precedence even if that changes.
#
#  DELIBERATELY ABSENT from [mysqld], each for a specific reason:
#    * `sql_mode`                      -- the dump sets `NO_AUTO_VALUE_ON_ZERO`
#                                         itself, per session
#                                         [mysql/ACASDB.sql:L21]
#    * `character-set-server` /
#      `collation-server`              -- would override the schema's own
#                                         `utf8mb3` table defaults and thereby
#                                         "fix" the charset caveat at
#                                         [mysql/ACASDB.sql:L9-L11] (R-4)
#    * `PAD_CHAR_TO_FULL_LENGTH`       -- would change how the 238 fixed-width
#                                         `char` columns read back, and trailing
#                                         -space canonicalisation is
#                                         `normalize.py`'s job, not the server's
#    * `innodb_flush_log_at_trx_commit`
#      and every other durability knob  -- changing durability changes commit
#                                         semantics, which is exactly what the
#                                         seeded and posted state depend on
#    * general / slow query log        -- writes timestamped output, i.e. a
#                                         non-deterministic artefact (R-6)
#    * `explicit_defaults_for_timestamp`
#                                      -- unnecessary: the 22 in-scope tables
#                                         contain zero TIMESTAMP columns
#    * any parallelism or pooling knob -- execution is strictly sequential and
#                                         there are no parallel scenario runs
#                                         against the shared database
#
#  NOTE for downstream scripts, stated as the contract they implement:
#    * `reset_db.sh` and `run_cobol_scenario.sh` ASSERT the runtime mode (ON) and
#      never set it. Their work -- the drop and re-apply, and the compiled posting
#      run -- is runtime application access, which the AAP does not scope OFF.
#    * `seed.sh` OWNS the seeding window: it sets the mode OFF around the frozen
#      loaders, asserts it inside the window, and restores ON from its exit trap
#      however the run ends. It never issues a COMMIT on a loader's behalf.
#    * Because the frozen loaders reach no COMMIT, that window leaves no durable
#      rows. `seed.sh` therefore MEASURES the seeded row counts when the window
#      closes and FAILS rather than reporting a success the tables do not show --
#      which is what stops an empty capture reaching `diff_states.py`, where an
#      empty diff is the pass condition.
# -----------------------------------------------------------------------------
RUN set -eu; \
    printf '%s\n' \
      '#' \
      '# ACAS compiled-COBOL oracle -- server configuration.' \
      '# Generated by harness/Dockerfile.mariadb. Do not edit in a running container.' \
      '#' \
      '# autocommit is SCOPED, not pinned:' \
      '#   runtime application access  ON            <- this file' \
      '#   the seeding window          either mode   <- harness/seed.sh, around the loaders' \
      '#' \
      '# The Agent Action Plan scopes autocommit to SEEDING, and all three of its' \
      '# provisions say so: section 0.2.1.1 ("the batch loader turns autocommit' \
      '# off"), section 0.5.2 ("autocommit must be off DURING SEEDING") and section' \
      '# 0.4.1.7 on this file ("autocommit off TO MATCH THE LOADERS" -- the loaders' \
      '# being the seeding stage). None of them scopes runtime access, so runtime' \
      '# access is served ON and seed.sh owns the window the AAP names. WHICH mode' \
      '# that window runs is seed.sh: MEASURED, ON is the only mode in which these' \
      '# loaders leave a durable row, so ON is its default and off is selectable.' \
      '#' \
      '# All three derive it from the loader banner at' \
      '# [common/glbatchLD.cbl:L9-L13], which appears in all 28 common/*LD.cbl:' \
      '#   "This modules uses commit and rollback so you MUST ensure that autocommit' \
      '#    is OFF in the rdb settings. It is as default set ON."' \
      '# The banner instructs the OPERATOR because no COBOL program can do it:' \
      '# the vendored cobmysqlapi38.c exposes MySQL_commit and MySQL_rollback but' \
      '# NOT MySQL_autocommit, so the mode can only be established from outside the' \
      '# frozen code -- here, and by seed.sh for its window.' \
      '#' \
      '# CONSEQUENCE, PRESERVED NOT REPAIRED (R-4): the shipped code never' \
      '# reaches a COMMIT. In all 28 loaders every "perform aa020-Rollback" is' \
      '# commented out (78 sites, none live), and "perform aa030-Commit" occurs' \
      '# exactly once anywhere -- [common/irsdfltLD.cbl:L437] -- also commented' \
      '# out. Both paragraphs are therefore dead code in every loader, each' \
      '# holding a live call "MySQL_commit"/"MySQL_rollback" nothing reaches.' \
      '# The twenty in-scope bridges, the in-scope handlers (acas007, acas008,' \
      '# acasirsub4) and every bridge close path contain zero' \
      '# COMMIT/ROLLBACK/START TRANSACTION.' \
      '#' \
      '# So inside the OFF window MariaDB discards each COBOL session at' \
      '# disconnect and the seed leaves no rows. The maintainer saw this himself' \
      '# -- [common/analLD.cbl:L442] "These do not work during testing with' \
      '# mariadb - Non transactional model or autocommit set ON". R-4 makes that' \
      '# observed behaviour the specification: a defect reproduced is correct, a' \
      '# defect fixed is a failure. Nothing here or in seed.sh issues the missing' \
      '# COMMIT; seed.sh measures the result and FAILS instead, so the defect is' \
      '# reported rather than laundered into an empty diff that reads as a pass.' \
      '#' \
      '# Set server-wide so every client -- COBOL loaders, COBOL bridges via' \
      '# cobmysqlapi.o, the mariadb CLI, and the Python driver -- inherits the' \
      '# same runtime mode. Both sides of the parity diff must see one server.' \
      '#' \
      '# Nothing else is set here by design: no sql_mode (the dump sets' \
      '# NO_AUTO_VALUE_ON_ZERO per session at [mysql/ACASDB.sql:L21]), no server' \
      '# charset/collation (that would "fix" the charset caveat at' \
      '# [mysql/ACASDB.sql:L9-L11], which must be preserved), no' \
      '# PAD_CHAR_TO_FULL_LENGTH, no durability change, no query logging.' \
      '#' \
      '[mysqld]' \
      'autocommit=1' \
      > /etc/mysql/conf.d/99-acas-oracle.cnf; \
    chmod 0644 /etc/mysql/conf.d/99-acas-oracle.cnf; \
    grep -qx 'autocommit=1' /etc/mysql/conf.d/99-acas-oracle.cnf; \
    ! grep -qx 'autocommit=0' /etc/mysql/conf.d/99-acas-oracle.cnf; \
    echo 'OK: runtime autocommit=1 declared; the seeding window is harness/seed.sh.'

#  Repository evidence [mysql/ACASDB.sql:L3], not an operator preference: the
#  frozen loaders and the generated bridges connect to this database by name.
ENV MARIADB_DATABASE=ACASDB

#  THE DISPOSABILITY MARKER, AND WHY IT IS NOT A TABLE.
#  harness/reset_db.sh will not drop and re-apply the 33 frozen tables until it can
#  prove the target is a throwaway this harness built. Proving it with a marker TABLE in a
#  second schema would need CREATE DATABASE, CREATE TABLE and INSERT -- DDL and DML, and
#  rule R-3 admits neither: "No new
#  tables, columns, indexes, constraints, views, triggers or DDL statements." The
#  schema being a separate one did not make the statements disappear, and a reset
#  gate that depends on them makes the rule's violation load-bearing.
#
#  SO THE PROOF IS A SERVER SETTING INSTEAD. `report_host` is a MariaDB system
#  variable that can only be set at startup, from a configuration file inside the
#  image; it is informational -- MariaDB uses it only to register a replica in
#  `SHOW SLAVE HOSTS` and this server is nobody's replica -- it is not schema, no
#  ACAS table or column is touched by it, and no migrated module or frozen program
#  reads it. A plain MariaDB container leaves it EMPTY, so the marker below can only
#  be seen on a server started from THIS image -- exactly the property the table had.
#
#  WHY `report_host` AND NOT `version_comment`, MEASURED (rule R-6). The first
#  attempt at this fix used `version_comment`, on the reading that a variable the
#  server reports must be a variable the server accepts. IT IS NOT: mariadbd 10.11.7
#  refuses it in an option file outright -- "unknown variable
#  'version_comment=...'" -- and REFUSES TO START, so the image could never come up.
#  `version_suffix` is refused the same way. `report_host` was accepted on the same
#  probe, with the long token below, which is why it is the one used. The value is a
#  SINGLE TOKEN with no spaces: the variable is hostname-typed, and a value carrying
#  spaces and parentheses is exactly what made the first attempt unreadable.
#
#  IT IS ONE OF THREE INDEPENDENT CHECKS, NOT THE WHOLE GATE. reset_db.sh also
#  requires the target host to be one this harness provisions (topology), and a
#  target-scoped consent token equal to `DESTROY <schema>@<host>:<port>` that names
#  the exact target being destroyed (explicit destructive acknowledgement). Any one
#  of the three failing is a refusal unless the acknowledgement names that target.
RUN set -eu; \
    printf '%s\n' \
      '#' \
      '# ACAS compiled-COBOL oracle -- harness disposability marker.' \
      '# Generated by harness/Dockerfile.mariadb. NOT part of the ACAS schema:' \
      '# this is a server setting, and no DDL or DML is issued anywhere for it' \
      '# (rule R-3). harness/reset_db.sh reads it back with `select' \
      '# @@report_host` and refuses to drop the 33 frozen tables on a server' \
      '# that does not carry it, because such a server is not this harness'"'"'s' \
      '# throwaway. It is informational only: nothing in the migrated cycle and' \
      '# nothing in the frozen COBOL reads it, it is never dumped, never' \
      '# normalised and never compared. This server is nobody'"'"'s replica, so' \
      '# the variable has no other effect at all.' \
      '#' \
      '[mysqld]' \
      'report_host=ACAS-harness-disposable-oracle' \
      > /etc/mysql/conf.d/98-acas-disposable-marker.cnf; \
    chmod 0644 /etc/mysql/conf.d/98-acas-disposable-marker.cnf; \
    grep -qx 'report_host=ACAS-harness-disposable-oracle' /etc/mysql/conf.d/98-acas-disposable-marker.cnf; \
    ! grep -qi 'create database' /etc/mysql/conf.d/98-acas-disposable-marker.cnf; \
    ! grep -qi 'create table' /etc/mysql/conf.d/98-acas-disposable-marker.cnf; \
    mariadbd --verbose --help >/dev/null 2>/tmp/marker-probe.err || { \
      echo 'FATAL: mariadbd refuses the marker option file:'; \
      cat /tmp/marker-probe.err; \
      exit 1; \
    }; \
    rm -f /tmp/marker-probe.err; \
    echo 'OK: disposability declared as a server setting mariadbd accepts; no DDL, no DML (R-3).'

COPY mysql/ACASDB.sql /docker-entrypoint-initdb.d/10-ACASDB.sql

#  The frozen-schema tripwire. The digest is an immutable constant in this file
#  and deliberately NOT a build argument: an overrideable digest would let a
#  modified schema be waved through with a matching --build-arg. The census that
#  follows it is the same one the rules require -- 33 CREATE TABLE, zero added
#  DDL, the utf8mb3 charset caveat preserved (R-4), and zero FLOAT/DOUBLE/REAL
#  tokens, because no accounting value may ever traverse a binary float (R-2).
RUN set -eu; \
    schema=/docker-entrypoint-initdb.d/10-ACASDB.sql; \
    \
    if [ -n "${ACASDB_SCHEMA_SHA256:-}" ]; then \
        echo "FATAL: ACASDB_SCHEMA_SHA256 is visible to this step." >&2; \
        echo "       The frozen-schema digest is an IMMUTABLE CONSTANT in this Dockerfile," >&2; \
        echo "       never a build argument: an overrideable tripwire lets a modified" >&2; \
        echo "       mysql/ACASDB.sql be waved through with a matching --build-arg." >&2; \
        echo "       Remove the ARG/ENV of that name and re-pin by editing this file." >&2; \
        exit 1; \
    fi; \
    \
    expected_sha=094e588226f650672c3781d1737d7bf8be30be048ce6a788df81800a19326ed0; \
    \
    echo '--- asserting the pinned architecture actually took effect ---'; \
    arch="$(dpkg --print-architecture)"; \
    if [ "${arch}" != 'amd64' ]; then \
        echo "FATAL: this image is being built for ${arch}, not amd64." >&2; \
        echo "       The FROM line pins --platform=linux/amd64 so that both halves of" >&2; \
        echo "       the parity comparison run on the architecture the frozen dump's own" >&2; \
        echo "       header records -- [mysql/ACASDB.sql:L1] \"for Linux (x86_64)\"." >&2; \
        exit 1; \
    fi; \
    echo "    dpkg architecture: ${arch}   uname -m: $(uname -m)"; \
    \
    echo '[R-3] verifying the frozen schema was copied byte-for-byte ...'; \
    actual_sha="$(sha256sum "${schema}")"; \
    actual_sha="${actual_sha%% *}"; \
    if [ "${actual_sha}" != "${expected_sha}" ]; then \
        echo "FATAL: mysql/ACASDB.sql is NOT byte-identical to the frozen baseline." >&2; \
        echo "       expected ${expected_sha}" >&2; \
        echo "       actual   ${actual_sha}" >&2; \
        echo "       The schema is frozen: any diff touching mysql/ACASDB.sql is a defect," >&2; \
        echo "       regardless of how harmless it appears. Revert it, do not re-pin." >&2; \
        exit 1; \
    fi; \
    \
    echo '[R-3] 33 CREATE TABLE statements, unchanged (22 in scope + 11 out of scope) ...'; \
    n_tables="$(grep -c '^CREATE TABLE ' "${schema}" || true)"; \
    [ "${n_tables}" = '33' ] || { echo "FATAL: expected 33 CREATE TABLE, found ${n_tables}." >&2; exit 1; }; \
    \
    echo '[R-3] zero real ALTER TABLE statements ...'; \
    n_alter="$(grep -cE '^[^/]*ALTER TABLE' "${schema}" || true)"; \
    [ "${n_alter}" = '0' ] || { echo "FATAL: ${n_alter} real ALTER TABLE statement(s) present." >&2; exit 1; }; \
    \
    echo '[R-3] zero CREATE INDEX / VIEW / TRIGGER / PROCEDURE statements ...'; \
    n_ddl="$(grep -ciE 'CREATE (INDEX|VIEW|TRIGGER|PROCEDURE|FUNCTION|DATABASE)' "${schema}" || true)"; \
    [ "${n_ddl}" = '0' ] || { echo "FATAL: ${n_ddl} added DDL statement(s) present." >&2; exit 1; }; \
    \
    echo '[R-4] charset caveat preserved: all 33 tables still utf8mb3_general_ci ...'; \
    n_cs="$(grep -c 'DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci' "${schema}" || true)"; \
    [ "${n_cs}" = '33' ] || { echo "FATAL: expected 33 utf8mb3_general_ci tables, found ${n_cs}; the charset caveat at [mysql/ACASDB.sql:L9-L11] must NOT be fixed." >&2; exit 1; }; \
    \
    echo '[R-2] zero FLOAT / DOUBLE / REAL tokens anywhere in the schema ...'; \
    n_float="$(grep -ciwE 'float|double|real' "${schema}" || true)"; \
    [ "${n_float}" = '0' ] || { echo "FATAL: ${n_float} line(s) carry a binary floating-point type; accounting values must never traverse a float." >&2; exit 1; }; \
    \
    echo 'OK: frozen schema verified verbatim -- 33 tables, 0 added DDL, utf8mb3 preserved, 0 float columns.'


# -----------------------------------------------------------------------------
#  SQL LEAST PRIVILEGE -- the application account is reduced to DML
#
#  THE DEFECT THIS CLOSES. The vendor entrypoint grants the application account
#  everything on the target schema:
#
#      userGrants="GRANT ALL ON \`${MARIADB_DATABASE//_/\\_}\`.* TO
#                  '$MARIADB_USER'@'%';"      -- vendor docker-entrypoint.sh:L441
#
#  `ALL` on a schema is DROP, CREATE, ALTER, INDEX, LOCK TABLES, CREATE
#  TEMPORARY TABLES, REFERENCES, TRIGGER, CREATE/SHOW VIEW, CREATE/ALTER
#  ROUTINE, EXECUTE and EVENT on top of the four statements the cycle actually
#  issues. So the credential the migrated cycle authenticates with every day
#  could drop all 33 tables -- and `harness/reset_db.sh` GATE 1 and
#  `harness/docker-compose.yml` both DOCUMENTED the opposite, that the
#  application account "does NOT hold the rights to drop the schema". The
#  separation was described but never provisioned. Removing the admin fallback
#  from reset_db.sh stopped that script from USING the runtime credential
#  destructively; it did not remove the CAPABILITY, which is what a leaked
#  credential exercises. This step removes the capability, and the two
#  documentation sites are corrected to match.
#
#  WHY THE FOUR ARE SUFFICIENT -- MEASURED, NOT ASSUMED. Every SQL verb the
#  application account can issue was enumerated across the twenty `dal/acas*`
#  handler modules and the harness Python tools. The result is SELECT, INSERT,
#  UPDATE and DELETE, plus session `SET` and transaction control, which need no
#  privilege. There is no TRUNCATE, no LOCK TABLES, no CREATE TEMPORARY TABLE
#  and no DDL on any runtime path. The one construct that reads like DDL is
#  `acas008`'s `Open-Output`, which AAP 0.6.5 establishes means "delete every
#  row" [common/acas008.cbl:L313-L319, L571-L574] and which the handler
#  reproduces as a DELETE -- so it needs DELETE, not DROP.
#
#  WHAT KEEPS WORKING. `harness/reset_db.sh` is the only consumer that performs
#  DDL and it authenticates as ACAS_DB_ADMIN_USER, which compose sets to `root`;
#  the vendor grants root `ALL ON *.*` (entrypoint L383/L389) and nothing here
#  touches it. `seed.sh` INSERTs, `dump_tables.py` SELECTs, the scenario runners
#  post -- all four verbs, all retained.
#
#  WHY A SOURCED `.sh` AND NOT A `.sql`. The account NAME is runtime-supplied --
#  compose passes `MARIADB_USER: ${ACAS_DB_USER:?...}` -- so it is unknown at
#  build time and cannot be baked into a static `.sql`. The vendor's
#  `docker_process_init_files` SOURCES a non-executable `.sh` into its own shell
#  (entrypoint L76-L86), which gives this script `$MARIADB_USER`,
#  `$MARIADB_DATABASE`, the `mysql_note`/`mysql_error` loggers and
#  `docker_process_sql`. Using the vendor's own helper is the point: it
#  authenticates via `MYSQL_PWD=$MARIADB_ROOT_PASSWORD` internally
#  (entrypoint L296-L303), so this script never reads, echoes, or passes a
#  password in argv, and no credential enters an image layer. The file is
#  deliberately left NON-executable -- 0644, not 0755 -- because that is what
#  selects the sourcing branch over the sub-process branch.
#
#  ORDERING IS LOAD-BEARING, AND VERIFIED. The vendor issues `${userGrants}` at
#  entrypoint L489 and only then replays initdb.d at L534, so a REVOKE here runs
#  AFTER the GRANT ALL and is not undone by it. Named `20-` so it also sorts
#  after `05-` (sentinel) and `10-ACASDB.sql` (frozen schema): the grant is
#  narrowed once the schema it applies to exists. The narrowed state lives in the
#  `mysql` grant tables inside the data directory, so it survives every restart
#  -- on a restart the entrypoint skips initdb.d, but it skips the GRANT ALL too.
#
#  THE DATABASE PATTERN IS ESCAPED THE WAY THE VENDOR ESCAPED IT. In a GRANT the
#  schema is a LIKE pattern, where `_` is a single-character wildcard. The vendor
#  wrote `${MARIADB_DATABASE//_/\\_}` and this REVOKE must name the identical
#  pattern or it will not match the grant it is trying to remove. `ACASDB`
#  contains no underscore, so the two forms coincide today -- the substitution is
#  reproduced anyway so that they cannot diverge if the name ever changes.
#
#  R-3 COMPLIANCE. This adds no table, column, index, constraint or DDL of any
#  kind to ACASDB: the schema still receives exactly the 33 frozen tables from
#  `mysql/ACASDB.sql`, whose byte-for-byte digest is asserted above and is
#  untouched by this step. REVOKE and GRANT administer a SERVER ACCOUNT; they are
#  not schema evolution, and they are invisible to every table dump and state
#  diff. What R-3 freezes is the schema, and the schema is unchanged.
#
#  IT VERIFIES ITSELF AND FAILS CLOSED. After narrowing, the script reads the
#  grant back out of `information_schema.SCHEMA_PRIVILEGES` and asserts the held
#  set is exactly the four expected privileges. If DROP is still present, or a
#  privilege is missing, `mysql_error` aborts initialisation -- so the container
#  never reaches "healthy" with a posture different from the one documented, and
#  the scripts that wait for healthy cannot race ahead of it.
# -----------------------------------------------------------------------------
#  ON QUOTING, BECAUSE IT IS THE ONE FRAGILE PART. The SQL needs single quotes
#  around the account name and the `%` host, and this file generates it from a
#  `printf` whose arguments are single-quoted -- so a literal single quote cannot
#  appear in them. Rather than escape through three layers (Dockerfile, /bin/sh,
#  then the generated script), the generated script obtains the character
#  arithmetically, `acas_q="$(printf '\047')"`, octal 39 being the apostrophe.
#  Every generated line is then plainly single-quoted with no escaping at all,
#  and the SQL is assembled by concatenation instead of a heredoc. An earlier
#  revision used a placeholder word and a trailing `sed` to swap it for a quote;
#  that is recorded here as rejected, because such a substitution rewrites the
#  placeholder wherever it occurs -- including inside the script's own comments.
RUN set -eu; \
    printf '%s\n' \
      '#!/bin/bash' \
      '#  ACAS compiled-COBOL oracle -- SQL least privilege for the application' \
      '#  account. Generated by harness/Dockerfile.mariadb; see the rationale' \
      '#  there. SOURCED by the vendor entrypoint (NOT executable, by design), so' \
      '#  $MARIADB_USER, $MARIADB_DATABASE, mysql_note/mysql_error and' \
      '#  docker_process_sql are all in scope and no credential is handled here.' \
      '#  bash, not sh: this is sourced into the vendor entrypoint, whose own' \
      '#  shebang is #!/bin/bash, and it uses the same bash-only pattern' \
      '#  substitution the vendor used to build the grant it narrows.' \
      '#' \
      '#  Runs AFTER the vendor GRANT ALL (entrypoint L489) because initdb.d is' \
      '#  replayed at L534. Narrows that grant to the four statements the' \
      '#  migrated cycle actually issues, then proves the result.' \
      '' \
      'if [ -z "${MARIADB_USER:-}" ]; then' \
      '    mysql_note "least privilege: no MARIADB_USER, so the vendor created no application account and there is no grant to narrow."' \
      '#  DEFENCE IN DEPTH, not the primary catch. Measured: the vendor rejects' \
      '#  MARIADB_USER=root earlier than this, with "ERROR 1396 Operation CREATE' \
      '#  USER failed" because the account already exists, so init aborts before' \
      '#  this branch is reached. It is kept because that ordering is the' \
      "#  vendor's to change, and because a superuser under any other name would" \
      '#  reach here and must not be narrowed.' \
      'elif [ "${MARIADB_USER}" = "root" ]; then' \
      '    mysql_error "least privilege: MARIADB_USER is root. Narrowing it would strip the administrative account reset_db.sh GATE 1 requires. Provision a separate application account."' \
      'elif [ -z "${MARIADB_DATABASE:-}" ]; then' \
      '    mysql_note "least privilege: no MARIADB_DATABASE, so the vendor issued no schema-scoped grant to narrow."' \
      'else' \
      '    #  Octal 39 is the apostrophe. Obtained this way so that no line of' \
      '    #  this generated file has to carry a literal single quote.' \
      '    acas_q="$(printf "\047")"' \
      '' \
      '    #  CHARACTER-FOR-CHARACTER the expansion the vendor used to build the' \
      '    #  grant being narrowed (entrypoint L441). In a GRANT the schema is a' \
      '    #  LIKE pattern, so an underscore is a wildcard and must be escaped;' \
      '    #  naming a different pattern here would fail to match the grant.' \
      '    acas_pat="${MARIADB_DATABASE//_/\\_}"' \
      '    acas_who="$(docker_sql_escape_string_literal "${MARIADB_USER}")"' \
      '' \
      '    #  THE HOST SCOPE. The vendor created the account as <user>@% -- any' \
      '    #  host anywhere. ACAS_DB_CLIENT_HOST_PATTERN narrows it to the network' \
      '    #  this stack is actually reachable from; a value of % is an explicit' \
      '    #  opt-out and is announced rather than silently doing nothing. UNSET' \
      '    #  keeps the vendor default; SET BUT EMPTY is a mistake and is refused,' \
      '    #  which is why the expansion uses ${VAR-default} and not ${VAR:-default}.' \
      '    #  A single quote in the pattern is refused outright rather than escaped:' \
      '    #  no legitimate host pattern contains one, and refusing keeps the' \
      '    #  generated SQL free of a value that would have to be trusted.' \
      '    acas_host="${ACAS_DB_CLIENT_HOST_PATTERN-%}"' \
      '    case "${acas_host}" in' \
      '        "") mysql_error "least privilege: ACAS_DB_CLIENT_HOST_PATTERN is set but empty. Unset it to keep the vendor default, or name a host pattern." ;;' \
      '        *${acas_q}*) mysql_error "least privilege: ACAS_DB_CLIENT_HOST_PATTERN contains a single quote, which no host pattern needs. Refusing rather than escaping it." ;;' \
      '    esac' \
      '' \
      '    if [ "${acas_host}" = "%" ]; then' \
      '        mysql_note "least privilege: ACAS_DB_CLIENT_HOST_PATTERN is %, so the host scope of ${MARIADB_USER} is NOT narrowed. This is the opt-out; set it to the harness network pattern to narrow."' \
      '    else' \
      '        #  RENAME USER carries the password hash AND every grant with it, so' \
      '        #  this narrows the scope without ever handling the credential and' \
      '        #  without re-issuing a grant. Verified below by reading the grantee' \
      '        #  back out of information_schema.' \
      '        mysql_note "least privilege: narrowing the host scope of ${MARIADB_USER} from % to ${acas_host}"' \
      '        printf "%s\n" \' \
      '            "RENAME USER ${acas_q}${acas_who}${acas_q}@${acas_q}%${acas_q} TO ${acas_q}${acas_who}${acas_q}@${acas_q}${acas_host}${acas_q};" \' \
      '            "FLUSH PRIVILEGES;" \' \
      '          | docker_process_sql --database=mysql --binary-mode' \
      '    fi' \
      '' \
      '    #  TWO FORMS OF THE SAME GRANTEE, AND THEY ARE NOT INTERCHANGEABLE.' \
      '    #  GRANT and REVOKE want it as SYNTAX -- the bare quoted user@host.' \
      '    #  information_schema.SCHEMA_PRIVILEGES stores it as DATA, quotes' \
      '    #  included, so comparing against it needs that same text as a SQL' \
      '    #  string LITERAL, which means every embedded quote doubled and the' \
      '    #  whole thing wrapped. Passing the syntax form to the comparison' \
      '    #  yields a doubled-up quote run and a 1064.' \
      '    acas_grantee="${acas_q}${acas_who}${acas_q}@${acas_q}${acas_host}${acas_q}"' \
      '    acas_grantee_lit="${acas_q}${acas_grantee//${acas_q}/${acas_q}${acas_q}}${acas_q}"' \
      '' \
      '    mysql_note "least privilege: reducing ${MARIADB_USER} on ${MARIADB_DATABASE} from ALL to SELECT, INSERT, UPDATE, DELETE (harness/Dockerfile.mariadb)"' \
      '' \
      '    #  THE REVOKE TAKES NO ON CLAUSE, AND THAT IS THE POINT. MariaDB has' \
      '    #  two REVOKE forms: a scoped one, REVOKE <privs> ON <level> FROM' \
      '    #  <user>, and a global one, REVOKE ALL PRIVILEGES, GRANT OPTION FROM' \
      '    #  <user>, which takes no ON clause at all -- writing one is a syntax' \
      '    #  error (1064). The global form is used deliberately: it clears every' \
      '    #  privilege at EVERY level -- global, schema, table, column and' \
      '    #  routine -- so no stray grant from any source can survive, whereas' \
      '    #  the scoped form would clear only the one schema named. The account' \
      '    #  keeps implicit USAGE and can still connect. The four privileges are' \
      '    #  then granted back explicitly, so the posture is additive from zero' \
      '    #  rather than subtractive from ALL.' \
      '    printf "%s\n" \' \
      '        "REVOKE ALL PRIVILEGES, GRANT OPTION FROM ${acas_grantee};" \' \
      '        "GRANT SELECT, INSERT, UPDATE, DELETE ON \`${acas_pat}\`.* TO ${acas_grantee};" \' \
      '        "FLUSH PRIVILEGES;" \' \
      '      | docker_process_sql --database=mysql --binary-mode' \
      '' \
      '    #  Prove it, and refuse to finish initialisation if the posture is not' \
      '    #  the documented one. SCHEMA_PRIVILEGES rather than SHOW GRANTS, so the' \
      '    #  result is one sorted string that can be compared exactly.' \
      '    acas_probe="SELECT IFNULL(GROUP_CONCAT(DISTINCT PRIVILEGE_TYPE"' \
      '    acas_probe="${acas_probe} ORDER BY PRIVILEGE_TYPE SEPARATOR ${acas_q},${acas_q})"' \
      '    acas_probe="${acas_probe}, ${acas_q}${acas_q}) FROM"' \
      '    acas_probe="${acas_probe} information_schema.SCHEMA_PRIVILEGES WHERE GRANTEE ="' \
      '    acas_probe="${acas_probe} ${acas_grantee_lit} AND TABLE_SCHEMA ="' \
      '    acas_probe="${acas_probe} ${acas_q}${MARIADB_DATABASE}${acas_q};"' \
      '' \
      '    acas_held="$(printf "%s\n" "${acas_probe}" \' \
      '        | docker_process_sql --database=mysql --skip-column-names --batch)"' \
      '    acas_held="$(printf %s "${acas_held}" | tr -d "[:space:]")"' \
      '' \
      '    if [ "${acas_held}" != "DELETE,INSERT,SELECT,UPDATE" ]; then' \
      '        mysql_error "least privilege VERIFICATION FAILED for ${MARIADB_USER} on ${MARIADB_DATABASE}: expected DELETE,INSERT,SELECT,UPDATE but the account holds ${acas_held:-<nothing>}. Refusing to finish initialisation, because the privilege separation documented in harness/docker-compose.yml and harness/reset_db.sh would not hold."' \
      '    fi' \
      '' \
      '    mysql_note "least privilege VERIFIED: ${MARIADB_USER} holds exactly ${acas_held} on ${MARIADB_DATABASE}; DROP, CREATE, ALTER, INDEX and LOCK TABLES are all absent."' \
      '' \
      '    #  Prove the host scope too, from the same authoritative table. The' \
      '    #  grantee the four privileges were read back FOR already embeds the' \
      '    #  narrowed host, so a non-empty result above is itself the proof that' \
      '    #  the RENAME took -- but say it explicitly, because a reader checking' \
      '    #  the posture should not have to infer it from a variable definition.' \
      '    mysql_note "least privilege VERIFIED: the grantee holding them is ${acas_grantee}, so the host scope is ${acas_host}."' \
      '' \
      '    #  ------------------------------------------------------------------' \
      '    #  THE ADMINISTRATIVE ACCOUNT -- PROVISIONED, SCOPED AND VERIFIED HERE' \
      '    #' \
      '    #  harness/reset_db.sh drops and re-applies the frozen schema, which the' \
      '    #  application account deliberately cannot do, so it authenticates as a' \
      '    #  DISTINCT account (its GATE 1 refuses one equal to the application' \
      '    #  account by name). That account used to be the SUPERUSER, which meant' \
      '    #  the harness carried a credential holding ALL PRIVILEGES ON *.* WITH' \
      '    #  GRANT OPTION plus PROXY -- everything the narrowing above removes from' \
      '    #  the application account, handed back in a second credential.' \
      '    #' \
      '    #  This account holds exactly what the two administrative stages need:' \
      '    #    * ALL on the ACAS schema, which supplies the six privileges the' \
      '    #      frozen file s own statements require -- DROP and CREATE for its 33' \
      '    #      drop/create pairs, LOCK TABLES and INSERT for its data sections,' \
      '    #      ALTER for the version-guarded key directives, SELECT to verify.' \
      '    #    * SUPER, and ONLY because SET GLOBAL autocommit needs it in MariaDB' \
      '    #      (there is no finer-grained system-variable privilege here). That is' \
      '    #      the seeding window harness/seed.sh opens around the frozen loaders.' \
      '    #' \
      '    #  It does NOT hold GRANT OPTION, CREATE USER, PROXY, FILE, SELECT on' \
      '    #  mysql.*, CREATE DATABASE, SHUTDOWN, or any privilege on any other' \
      '    #  schema -- all of which the superuser held. Every one of those is' \
      '    #  asserted below, and a failure aborts initialisation rather than' \
      '    #  logging a warning.' \
      '    #' \
      '    #  ONE RESIDUAL CAPABILITY, DISCLOSED: ALL on a schema includes DROP, and' \
      '    #  in MariaDB schema-level DROP permits DROP DATABASE as well as DROP' \
      '    #  TABLE. So this account can destroy the ACAS schema itself. That is' \
      '    #  kept rather than narrowed because ALL on the one schema is the' \
      '    #  practical minimum for applying a 33-table dump, and table-level DROP' \
      '    #  grants cannot be relied on to survive the drop half of a' \
      '    #  drop-and-recreate. The exposure is bounded to the one disposable' \
      '    #  schema this stack exists to destroy and rebuild twice per run.' \
      '    #  Recovery, if it ever happens: recreate the database volume -- neither' \
      '    #  this account nor reset_db.sh can CREATE DATABASE.' \
      '    #  ------------------------------------------------------------------' \
      '    if [ -z "${ACAS_DB_ADMIN_USER:-}" ] && [ -z "${ACAS_DB_ADMIN_PASSWORD:-}" ]; then' \
      '        mysql_note "administrative account: ACAS_DB_ADMIN_USER and ACAS_DB_ADMIN_PASSWORD are both unset, so none is provisioned. harness/reset_db.sh GATE 1 will refuse to run until one exists."' \
      '    elif [ -z "${ACAS_DB_ADMIN_USER:-}" ] || [ -z "${ACAS_DB_ADMIN_PASSWORD:-}" ]; then' \
      '        mysql_error "administrative account: ACAS_DB_ADMIN_USER and ACAS_DB_ADMIN_PASSWORD must be set together. One without the other would provision either a passwordless administrative account or nothing at all, and neither is an acceptable outcome to reach silently."' \
      '    elif [ "${ACAS_DB_ADMIN_USER}" = "${MARIADB_USER}" ]; then' \
      '        mysql_error "administrative account: ACAS_DB_ADMIN_USER equals MARIADB_USER (${MARIADB_USER}). harness/reset_db.sh GATE 1 exists to keep the account that posts separate from the account that can destroy the schema, and provisioning them as one account would defeat it."' \
      '    elif [ "${ACAS_DB_ADMIN_USER}" = "root" ]; then' \
      '        mysql_error "administrative account: ACAS_DB_ADMIN_USER is root. The superuser is deliberately socket-only here (MARIADB_ROOT_HOST=localhost), and the point of this account is to be narrower than root. Name a separate account."' \
      '    else' \
      '        acas_adm="$(docker_sql_escape_string_literal "${ACAS_DB_ADMIN_USER}")"' \
      '        acas_adm_pw="$(docker_sql_escape_string_literal "${ACAS_DB_ADMIN_PASSWORD}")"' \
      '        acas_adm_grantee="${acas_q}${acas_adm}${acas_q}@${acas_q}${acas_host}${acas_q}"' \
      '        acas_adm_grantee_lit="${acas_q}${acas_adm_grantee//${acas_q}/${acas_q}${acas_q}}${acas_q}"' \
      '' \
      '        mysql_note "administrative account: provisioning ${ACAS_DB_ADMIN_USER} at ${acas_host} with ALL on ${MARIADB_DATABASE} and SUPER, and nothing else"' \
      '' \
      '        #  The password is a SHELL VARIABLE expansion, never a literal in' \
      '        #  this file: the image layer carries no credential, and the value' \
      '        #  exists only in the running server process environment.' \
      '        acas_adm_create="CREATE USER ${acas_adm_grantee} IDENTIFIED BY ${acas_q}${acas_adm_pw}${acas_q};"' \
      '        printf "%s\n" \' \
      '            "${acas_adm_create}" \' \
      '            "GRANT ALL ON \`${acas_pat}\`.* TO ${acas_adm_grantee};" \' \
      '            "GRANT SUPER ON *.* TO ${acas_adm_grantee};" \' \
      '            "FLUSH PRIVILEGES;" \' \
      '          | docker_process_sql --database=mysql --binary-mode' \
      '        unset acas_adm_create acas_adm_pw' \
      '' \
      '        #  1. The GLOBAL set must be SUPER and nothing else. USAGE is the' \
      '        #     implicit "may connect" row, and MEASURED on this server it' \
      '        #     disappears from USER_PRIVILEGES as soon as a real global' \
      '        #     privilege exists -- so it is tolerated in either direction' \
      '        #     rather than expected, and SUPER is what is actually asserted.' \
      '        #     Anything else here -- FILE, CREATE USER, SELECT, RELOAD -- is a' \
      '        #     posture this file does not describe.' \
      '        acas_probe="SELECT IFNULL(GROUP_CONCAT(DISTINCT PRIVILEGE_TYPE"' \
      '        acas_probe="${acas_probe} ORDER BY PRIVILEGE_TYPE SEPARATOR ${acas_q},${acas_q})"' \
      '        acas_probe="${acas_probe}, ${acas_q}${acas_q}) FROM"' \
      '        acas_probe="${acas_probe} information_schema.USER_PRIVILEGES WHERE GRANTEE ="' \
      '        acas_probe="${acas_probe} ${acas_adm_grantee_lit};"' \
      '        acas_held="$(printf "%s\n" "${acas_probe}" \' \
      '            | docker_process_sql --database=mysql --skip-column-names --batch)"' \
      '        acas_held="$(printf %s "${acas_held}" | tr -d "[:space:]")"' \
      '        acas_globals=",${acas_held},"' \
      '        acas_globals="${acas_globals//,USAGE,/,}"' \
      '        if [ "${acas_globals}" != ",SUPER," ]; then' \
      '            mysql_error "administrative account VERIFICATION FAILED: expected the global privileges of ${ACAS_DB_ADMIN_USER} to be SUPER and nothing else, but they are ${acas_held:-<nothing>}. Refusing to finish initialisation: an administrative account wider than SUPER is the finding this provisioning exists to close."' \
      '        fi' \
      '        unset acas_globals' \
      '        mysql_note "administrative account VERIFIED: global privileges are exactly ${acas_held} -- no FILE, no CREATE USER, no global SELECT, no RELOAD, no SHUTDOWN."' \
      '' \
      '        #  2. GRANT OPTION must be absent at EVERY level. This is what stops' \
      '        #     the account re-widening itself or the application account.' \
      '        acas_probe="SELECT IFNULL(GROUP_CONCAT(DISTINCT g SEPARATOR ${acas_q},${acas_q}), ${acas_q}${acas_q}) FROM ("' \
      '        acas_probe="${acas_probe} SELECT IS_GRANTABLE AS g FROM information_schema.USER_PRIVILEGES"' \
      '        acas_probe="${acas_probe} WHERE GRANTEE = ${acas_adm_grantee_lit}"' \
      '        acas_probe="${acas_probe} UNION ALL"' \
      '        acas_probe="${acas_probe} SELECT IS_GRANTABLE AS g FROM information_schema.SCHEMA_PRIVILEGES"' \
      '        acas_probe="${acas_probe} WHERE GRANTEE = ${acas_adm_grantee_lit}"' \
      '        acas_probe="${acas_probe} ) AS x;"' \
      '        acas_held="$(printf "%s\n" "${acas_probe}" \' \
      '            | docker_process_sql --database=mysql --skip-column-names --batch)"' \
      '        acas_held="$(printf %s "${acas_held}" | tr -d "[:space:]")"' \
      '        if [ "${acas_held}" != "NO" ]; then' \
      '            mysql_error "administrative account VERIFICATION FAILED: the IS_GRANTABLE column reads ${acas_held:-<nothing>} rather than NO, so ${ACAS_DB_ADMIN_USER} holds GRANT OPTION somewhere and could widen itself or the application account. Refusing to finish initialisation."' \
      '        fi' \
      '        mysql_note "administrative account VERIFIED: GRANT OPTION absent at every level."' \
      '' \
      '        #  3. The SCHEMA set must contain the six privileges' \
      '        #     harness/reset_db.sh asserts, and must be scoped to the ACAS' \
      '        #     schema alone -- reading the schema NAMES back proves both that' \
      '        #     the grant landed and that nothing else was granted.' \
      '        acas_probe="SELECT IFNULL(GROUP_CONCAT(DISTINCT TABLE_SCHEMA"' \
      '        acas_probe="${acas_probe} ORDER BY TABLE_SCHEMA SEPARATOR ${acas_q},${acas_q})"' \
      '        acas_probe="${acas_probe}, ${acas_q}${acas_q}) FROM"' \
      '        acas_probe="${acas_probe} information_schema.SCHEMA_PRIVILEGES WHERE GRANTEE ="' \
      '        acas_probe="${acas_probe} ${acas_adm_grantee_lit};"' \
      '        acas_held="$(printf "%s\n" "${acas_probe}" \' \
      '            | docker_process_sql --database=mysql --skip-column-names --batch)"' \
      '        acas_held="$(printf %s "${acas_held}" | tr -d "[:space:]")"' \
      '        if [ "${acas_held}" != "${MARIADB_DATABASE}" ]; then' \
      '            mysql_error "administrative account VERIFICATION FAILED: ${ACAS_DB_ADMIN_USER} holds schema privileges on ${acas_held:-<nothing>} rather than on ${MARIADB_DATABASE} alone. Refusing to finish initialisation."' \
      '        fi' \
      '' \
      '        acas_probe="SELECT IFNULL(GROUP_CONCAT(DISTINCT PRIVILEGE_TYPE"' \
      '        acas_probe="${acas_probe} ORDER BY PRIVILEGE_TYPE SEPARATOR ${acas_q},${acas_q})"' \
      '        acas_probe="${acas_probe}, ${acas_q}${acas_q}) FROM"' \
      '        acas_probe="${acas_probe} information_schema.SCHEMA_PRIVILEGES WHERE GRANTEE ="' \
      '        acas_probe="${acas_probe} ${acas_adm_grantee_lit} AND TABLE_SCHEMA ="' \
      '        acas_probe="${acas_probe} ${acas_q}${MARIADB_DATABASE}${acas_q};"' \
      '        acas_held="$(printf "%s\n" "${acas_probe}" \' \
      '            | docker_process_sql --database=mysql --skip-column-names --batch)"' \
      '        acas_held="$(printf %s "${acas_held}" | tr -d "[:space:]")"' \
      '        for acas_need in ALTER CREATE DROP INSERT SELECT; do' \
      '            case ",${acas_held}," in' \
      '                *",${acas_need},"*) : ;;' \
      '                *) mysql_error "administrative account VERIFICATION FAILED: ${ACAS_DB_ADMIN_USER} is missing ${acas_need} on ${MARIADB_DATABASE}; harness/reset_db.sh precondition 9 requires DROP, CREATE, LOCK TABLES, ALTER, INSERT and SELECT to apply the frozen schema. Held: ${acas_held:-<nothing>}." ;;' \
      '            esac' \
      '        done' \
      '        case ",${acas_held}," in' \
      '            *",LOCKTABLES,"*) : ;;' \
      '            *) mysql_error "administrative account VERIFICATION FAILED: ${ACAS_DB_ADMIN_USER} is missing LOCK TABLES on ${MARIADB_DATABASE}, which the frozen schema file s own data sections require. Held: ${acas_held:-<nothing>}." ;;' \
      '        esac' \
      '        mysql_note "administrative account VERIFIED: holds ${acas_held} on ${MARIADB_DATABASE} and on no other schema."' \
      '' \
      '        unset acas_adm acas_adm_grantee acas_adm_grantee_lit acas_need' \
      '    fi' \
      '' \
      '    #  ------------------------------------------------------------------' \
      '    #  AND THE SUPERUSER MUST NOT BE REACHABLE OVER THE NETWORK' \
      '    #' \
      '    #  MARIADB_ROOT_HOST=localhost is what achieves this, and it is set in' \
      '    #  harness/docker-compose.yml -- a FILE THIS SCRIPT CANNOT SEE. So the' \
      '    #  server asserts the outcome rather than trusting the setting: if any' \
      '    #  root account exists at a host other than localhost, initialisation' \
      '    #  fails here instead of the stack coming up healthy with a' \
      '    #  network-reachable ALL PRIVILEGES + GRANT OPTION + PROXY account.' \
      '    #  ------------------------------------------------------------------' \
      '    acas_probe="SELECT IFNULL(GROUP_CONCAT(DISTINCT Host ORDER BY Host"' \
      '    acas_probe="${acas_probe} SEPARATOR ${acas_q},${acas_q}), ${acas_q}${acas_q})"' \
      '    acas_probe="${acas_probe} FROM mysql.user WHERE User = ${acas_q}root${acas_q};"' \
      '    acas_held="$(printf "%s\n" "${acas_probe}" \' \
      '        | docker_process_sql --database=mysql --skip-column-names --batch)"' \
      '    acas_held="$(printf %s "${acas_held}" | tr -d "[:space:]")"' \
      '    case "${acas_held}" in' \
      '        localhost|::1,localhost|127.0.0.1,localhost|127.0.0.1,::1,localhost) : ;;' \
      '        *) mysql_error "superuser scope VERIFICATION FAILED: root exists at host(s) ${acas_held:-<nothing>}, which includes a network-reachable one. Set MARIADB_ROOT_HOST=localhost so the vendor entrypoint creates no second superuser account (its own guard, entrypoint lines 377 to 390). Refusing to finish initialisation: a network-reachable superuser makes every narrowing above decorative." ;;' \
      '    esac' \
      '    mysql_note "superuser scope VERIFIED: root exists only at ${acas_held}, so it is reachable over this container s unix socket alone."' \
      '' \
      '    unset acas_q acas_pat acas_who acas_host acas_grantee acas_grantee_lit acas_probe acas_held' \
      'fi' \
      > /docker-entrypoint-initdb.d/20-acas-least-privilege.sh; \
    chmod 0644 /docker-entrypoint-initdb.d/20-acas-least-privilege.sh; \
    \
    echo '--- asserting the least-privilege script is well-formed ---'; \
    bash -n /docker-entrypoint-initdb.d/20-acas-least-privilege.sh; \
    grep -q 'REVOKE ALL PRIVILEGES' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh; \
    grep -q 'GRANT SELECT, INSERT, UPDATE, DELETE' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh; \
    grep -q 'DELETE,INSERT,SELECT,UPDATE' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh; \
    \
    echo '--- the three account-topology controls must each be present ---'; \
    grep -q 'RENAME USER' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh \
      || { echo 'FATAL: the host-scope narrowing is absent; the application account would stay at the vendor wildcard.' >&2; exit 1; }; \
    grep -q 'GRANT SUPER ON \*\.\*' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh \
      || { echo 'FATAL: the administrative account provisioning is absent; reset_db.sh GATE 1 would have nothing but the superuser to use.' >&2; exit 1; }; \
    grep -q 'superuser scope VERIFICATION FAILED' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh \
      || { echo 'FATAL: the socket-only superuser assertion is absent; MARIADB_ROOT_HOST lives in a file this script cannot see, so the outcome must be asserted server-side.' >&2; exit 1; }; \
    grep -q 'information_schema.USER_PRIVILEGES' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh \
      || { echo 'FATAL: the administrative account global-privilege read-back is absent.' >&2; exit 1; }; \
    grep -q 'IS_GRANTABLE' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh \
      || { echo 'FATAL: the GRANT OPTION absence check is missing; without it the administrative account could widen itself.' >&2; exit 1; }; \
    \
    echo '--- it must NOT be executable: the vendor SOURCES a non-executable .sh ---'; \
    [ ! -x /docker-entrypoint-initdb.d/20-acas-least-privilege.sh ] \
      || { echo 'FATAL: the script is executable, so the vendor would run it as a sub-process and $MARIADB_USER, mysql_error and docker_process_sql would all be out of scope.' >&2; exit 1; }; \
    \
    echo '--- it must sort AFTER the frozen schema ---'; \
    first="$(ls /docker-entrypoint-initdb.d/ | sort | head -1)"; \
    last="$(ls /docker-entrypoint-initdb.d/ | sort | tail -1)"; \
    [ "${first}" = '10-ACASDB.sql' ] \
      || { echo "FATAL: expected the frozen schema to sort first, got ${first}." >&2; exit 1; }; \
    [ "${last}" = '20-acas-least-privilege.sh' ] \
      || { echo "FATAL: expected the least-privilege script to sort last, got ${last}." >&2; exit 1; }; \
    \
    echo '--- initdb.d must carry NO added DDL beyond the frozen schema (R-3) ---'; \
    for entry in /docker-entrypoint-initdb.d/*; do \
      case "${entry}" in \
        */10-ACASDB.sql|*/20-acas-least-privilege.sh) continue ;; \
      esac; \
      echo "FATAL: ${entry} is an added initdb.d member; the disposability marker is a server setting now, not a schema." >&2; \
      exit 1; \
    done; \
    \
    echo '--- no credential may appear in this image layer ---'; \
    ! grep -qiE 'MARIADB_PASSWORD=|MYSQL_PWD=' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh \
      || { echo 'FATAL: the least-privilege script assigns a credential variable.' >&2; exit 1; }; \
    \
    echo '--- and every IDENTIFIED BY must EXPAND a variable, never carry a literal ---'; \
    if grep -i 'IDENTIFIED BY' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh \
         | grep -vq '\${'; then \
        echo 'FATAL: an IDENTIFIED BY clause in the least-privilege script does not expand a shell variable, so it carries a literal credential into this image layer.' >&2; \
        grep -in 'IDENTIFIED BY' /docker-entrypoint-initdb.d/20-acas-least-privilege.sh | grep -v '\${' >&2; \
        exit 1; \
    fi; \
    echo '    (the administrative account needs IDENTIFIED BY; what it must never do is hold a value)'; \
    \
    echo "OK: initdb.d order $(ls /docker-entrypoint-initdb.d/ | sort | tr '\n' ' ')"


# -----------------------------------------------------------------------------
#  OS PRIVILEGE POSTURE -- LEAST PRIVILEGE, AND WHY THERE IS NO `USER` HERE
#
#  The step above narrowed the application account's SQL privileges. This one is
#  about the container's OS privileges, which are a separate axis: an account
#  that cannot issue DROP is still a concern if the process it talks to runs as
#  root. Both are needed and neither substitutes for the other.
#
#  This image deliberately does NOT carry a `USER` instruction, and that is a
#  correctness requirement rather than an oversight. The vendor entrypoint
#  performs its OWN privilege drop: it starts as root, fixes the data directory
#  if required, and then re-executes itself under the unprivileged `mysql`
#  account (`exec gosu mysql "${BASH_SOURCE[0]}" "$@"`). Forcing `USER mysql`
#  here pre-empts that logic and breaks first boot on any data directory the
#  container does not already own -- notably a host bind mount, which Docker
#  does not re-own.
#
#  So the server ends up unprivileged either way; the question is only what the
#  BRIEFLY-root entrypoint is permitted to do. That is constrained from the
#  compose side, where it can be expressed without breaking the drop:
#
#      cap_drop:      [ALL]
#      cap_add:       [CHOWN, SETGID, SETUID, DAC_OVERRIDE, FOWNER]
#      security_opt:  [no-new-privileges:true]
#
#  Those values are MEASURED, not guessed. Probed on this stack against a fresh
#  named volume:
#
#      SETGID + SETUID only ................ starts and becomes healthy
#      + CHOWN, DAC_OVERRIDE, FOWNER ....... starts and becomes healthy
#      ALL dropped, nothing added .......... FAILS, and says exactly why:
#          "Switching to dedicated user 'mysql'"
#          "error: failed switching to \"mysql\": operation not permitted"
#
#  SETGID and SETUID are therefore the irreducible pair -- they are what the
#  privilege drop itself consumes. CHOWN, DAC_OVERRIDE and FOWNER are retained
#  on top because the entrypoint chowns the data directory when it does not
#  already own it; a fresh NAMED volume inherits ownership from this image and
#  so does not need them, but a bind-mounted directory does, and failing on a
#  bind mount would be a fixture trap rather than a security gain. Every
#  NETWORK and KERNEL capability the default set would grant -- NET_RAW,
#  NET_BIND_SERVICE, NET_ADMIN, MKNOD, SYS_CHROOT, KILL, AUDIT_WRITE -- is
#  dropped and none is added back. After the drop the server process holds
#  `CapEff: 0000000000000000`, verified in the same probe.
#
#  SETUID/SETGID BINARIES ARE STRIPPED
#  -----------------------------------
#  The base image inherits the distribution's usual set-user-ID helpers, none of
#  which this container's function requires: it serves one database and never
#  changes user, mounts a filesystem or edits an account. They are cleared so
#  that a process which somehow gains file-system access cannot use one of them
#  to regain privilege. This is defence in depth alongside
#  `no-new-privileges:true`, which already neuters the set-user-ID bit at the
#  kernel level -- both are kept because they fail independently.
#
#  Two things are deliberately NOT stripped:
#
#    * `gosu` -- verified NOT to be set-user-ID. It works because the
#      entrypoint is already root, so clearing bits elsewhere cannot break the
#      privilege drop. This was checked before stripping, not assumed.
#    * the vendor's own `auth_pam_tool` under /usr/lib/mysql/plugin/ -- a
#      MariaDB component. ACAS authenticates with native MariaDB accounts and
#      never PAM, but reaching into a vendor plugin directory is over-reach for
#      a fixture image and risks a subtle, hard-to-diagnose failure. It is left
#      exactly as shipped and recorded here so the decision is visible.
#
#  The assertion below fails the build if the privilege-drop machinery is not
#  intact, so a future base-image change cannot quietly remove it.
# -----------------------------------------------------------------------------
RUN set -eu; \
    echo '--- asserting the unprivileged service account exists ---'; \
    id mysql; \
    mysql_uid="$(id -u mysql)"; \
    [ "${mysql_uid}" != '0' ] \
      || { echo 'FATAL: the mysql account resolves to uid 0; the entrypoint privilege drop would be a no-op.' >&2; exit 1; }; \
    \
    echo '--- asserting the privilege-drop helper is present ---'; \
    command -v gosu > /dev/null \
      || { echo 'FATAL: gosu is absent; the vendor entrypoint cannot drop privileges and the server would run as root.' >&2; exit 1; }; \
    \
    echo '--- clearing set-user-ID / set-group-ID bits on distribution helpers ---'; \
    find / -xdev -perm /6000 -type f \
         -not -path '/usr/lib/mysql/plugin/*' \
         -print -exec chmod -s {} + ; \
    \
    echo '--- verifying only the vendor plugin retains a set-*-ID bit ---'; \
    remaining="$(find / -xdev -perm /6000 -type f -not -path '/usr/lib/mysql/plugin/*' | wc -l)"; \
    [ "${remaining}" = '0' ] \
      || { echo "FATAL: ${remaining} set-user-ID/set-group-ID binaries remain outside the vendor plugin directory." >&2; \
           find / -xdev -perm /6000 -type f -not -path '/usr/lib/mysql/plugin/*' >&2; exit 1; }; \
    \
    echo '--- gosu must still be usable after the strip ---'; \
    gosu mysql id \
      || { echo 'FATAL: gosu can no longer switch to the mysql account; the privilege drop is broken.' >&2; exit 1; }; \
    \
    echo "OK: unprivileged account mysql (uid ${mysql_uid}) present, gosu intact, set-*-ID helpers cleared."


# -----------------------------------------------------------------------------
#  THE SOFTWARE BILL OF MATERIALS -- SHIPPED IN THE IMAGE, PRODUCED BY dpkg
#
#  WHY IT IS HERE. Advisory closure was previously unverifiable without a
#  third-party scanner: a reviewer with no `trivy`, `grype` or `syft` on the host
#  could not establish WHAT this image contains, let alone whether it is patched.
#  That made the posture recorded in README-python-migration.md section 7.2 a claim
#  rather than a finding, which is exactly the failure mode this project refuses
#  everywhere else.
#
#  So the image carries its own inventory, produced by the package manager that
#  installed everything in it. `dpkg-query` needs no network, no database and no
#  tool that is not already present, so the evidence exists on every host and
#  cannot go stale relative to the image: it is generated from the final layer's
#  package state, in the image it describes.
#
#  WHAT IT IS NOT. It is not a CVE verdict and does not claim to be one -- mapping
#  versions to advisories needs a vulnerability database, which a fixture image has
#  no business carrying. It is the INPUT a scanner needs and the record a human
#  needs: exact binary and source versions, the apt serial they were resolved at,
#  and the proof that nothing further was on offer at that serial.
# -----------------------------------------------------------------------------
ARG ACAS_SBOM_DIR=/usr/local/share/acas-harness

RUN set -eu; \
    mkdir -p "${ACAS_SBOM_DIR}"; \
    \
    echo '--- the package inventory: one TAB-separated row per installed package ---'; \
    { \
      printf '# ACAS harness image inventory -- MariaDB oracle service\n'; \
      printf '# image\tdocker.io/library/mariadb:10.11.7 (digest-pinned; see LABEL org.opencontainers.image.base.digest)\n'; \
      printf '# apt-snapshot\t%s\n' "${APT_SNAPSHOT}"; \
      printf '# columns\tpackage\tversion\tarchitecture\tsource-package\tsource-version\n'; \
      dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\t${source:Package}\t${source:Version}\n' \
        | LC_ALL=C sort; \
    } > "${ACAS_SBOM_DIR}/sbom-dpkg.tsv"; \
    packages="$(grep -vc '^#' "${ACAS_SBOM_DIR}/sbom-dpkg.tsv")"; \
    [ "${packages}" -gt 0 ] \
      || { echo 'FATAL: the package inventory is empty, so the image describes nothing.' >&2; exit 1; }; \
    \
    echo '--- the advisory posture: what was applied, what is held, and what remains on offer ---'; \
    { \
      printf 'artifact\tacas-harness image advisory posture\n'; \
      printf 'service\toracle-database\n'; \
      printf 'apt-snapshot-serial\t%s\n' "${APT_SNAPSHOT}"; \
      printf 'apt-sources\t%s\n' "$(tr '\n' ';' < /etc/apt/sources.list)"; \
      printf 'installed-packages\t%s\n' "${packages}"; \
      printf 'distribution-upgrades-applied\tevery upgrade offered at the pinned serial, asserted by re-reading apt-get -s upgrade during the build\n'; \
      printf 'pending-upgrades-at-pinned-serial\t0 (build fails otherwise)\n'; \
      printf 'held-packages\t%s\n' "$(apt-mark showhold | LC_ALL=C sort | tr '\n' ' ')"; \
      printf 'held-because\tthe frozen schema header names the server version [mysql/ACASDB.sql:L1]\n'; \
      printf 'mariadb-server\t%s\n' "$(dpkg-query -W -f='${Version}' mariadb-server)"; \
      printf 'go-binaries\t0 (the vendor gosu helper is replaced by a setpriv shim; see its own layer)\n'; \
      printf 'unfixable-residue\trecorded in README-python-migration.md section 7.2; no distribution fix exists for any of it\n'; \
      printf 'verify-command\tapt-get update && apt-get -s upgrade   (expects: no Inst lines)\n'; \
      printf 'inventory\t%s/sbom-dpkg.tsv\n' "${ACAS_SBOM_DIR}"; \
    } > "${ACAS_SBOM_DIR}/advisory-posture.tsv"; \
    \
    echo '--- both records must be world-readable: the service runs as mysql, not root ---'; \
    chmod 0644 "${ACAS_SBOM_DIR}/sbom-dpkg.tsv" "${ACAS_SBOM_DIR}/advisory-posture.tsv"; \
    \
    echo "OK: inventory of ${packages} packages and the advisory posture written to ${ACAS_SBOM_DIR}"; \
    head -4 "${ACAS_SBOM_DIR}/sbom-dpkg.tsv"

#  Declared for the internal project network only; harness/docker-compose.yml
#  publishes no port, so the credentials never reach the host.
EXPOSE 3306

#  The gate every stage waits on. `--innodb_initialized` is the load-bearing
#  part: the container starts before the frozen schema has been applied, so a
#  probe that only checked liveness would let a stage race the initialisation.
#  harness/docker-compose.yml restates this vector byte-for-byte.
HEALTHCHECK --interval=5s --timeout=10s --start-period=30s --retries=24 \
    CMD healthcheck.sh --su-mysql --connect --innodb_initialized
